+/*
+ * The whole bring-up as one synchronous, idempotent unit.
+ *
+ * Serialised by bringup_lock; a call once READY returns success without
+ * touching the hardware, so wifi.start may trigger it unconditionally.
+ * Timestamps are boot-relative so early and deferred runs can be compared
+ * directly against the WLAN driver's own WIFI_START log line.
+ */
+static int mt8163_stp_do_bringup(struct mt8163_stp *stp)
+{
+	unsigned int attempt;
+	ktime_t t0;
+	int ret = 0;
+
+	mutex_lock(&stp->bringup_lock);
+
+	if (stp->bringup_state == MT8163_STP_BRINGUP_READY) {
+		mutex_unlock(&stp->bringup_lock);
+		return 0;
+	}
+
+	stp->bringup_state = MT8163_STP_BRINGUP_RUNNING;
+	t0 = ktime_get();
+	dev_warn(stp->dev, "BISCUIT-BRINGUP start mode=%s boot_ms=%lld\n",
+		 bringup_deferred ? "deferred" : "early",
+		 ktime_to_ms(ktime_get_boottime()));
+
+	for (attempt = 1; ; attempt++) {
+		ret = mt8163_stp_bringup(stp, stp->pdev);
+		if (!ret)
+			break;
+		/* A missing BTIF is a dependency problem, not a flaky one. */
+		if (ret == -EPROBE_DEFER)
+			goto out;
+		if (attempt >= MT8163_STP_BRINGUP_ATTEMPTS) {
+			dev_err(stp->dev,
+				"CONSYS bring-up failed after %u attempts (%d)\n",
+				attempt, ret);
+			goto out;
+		}
+		dev_warn(stp->dev,
+			 "CONSYS bring-up attempt %u failed (%d); power-cycling and retrying\n",
+			 attempt, ret);
+		msleep(MT8163_STP_BRINGUP_BACKOFF_MS * attempt);
+	}
+
+	ret = mt8163_stp_hci_register(stp);
+	if (ret) {
+		mt8163_stp_bringup_unwind(stp);
+		goto out;
+	}
+
+	dev_warn(stp->dev,
+		 "BISCUIT-BRINGUP ready mode=%s took_ms=%lld boot_ms=%lld\n",
+		 bringup_deferred ? "deferred" : "early",
+		 ktime_to_ms(ktime_sub(ktime_get(), t0)),
+		 ktime_to_ms(ktime_get_boottime()));
+
+out:
+	stp->bringup_state = ret ? MT8163_STP_BRINGUP_FAILED :
+				   MT8163_STP_BRINGUP_READY;
+	mutex_unlock(&stp->bringup_lock);
+	return ret;
+}
+
+/* Write 1 to run bring-up now and block until it is READY (or has failed). */
+static int bringup_now_set(const char *val, const struct kernel_param *kp)
+{
+	struct mt8163_stp *stp = stp_for_param;
+	bool go;
+	int ret;
+
+	ret = kstrtobool(val, &go);
+	if (ret)
+		return ret;
+	if (!go)
+		return 0;
+	if (!stp)
+		return -ENODEV;
+	return mt8163_stp_do_bringup(stp);
+}
+
+static const struct kernel_param_ops bringup_now_ops = {
+	.set = bringup_now_set,
+};
+module_param_cb(bringup_now, &bringup_now_ops, NULL, 0200);
+MODULE_PARM_DESC(bringup_now,
+		 "write 1 to perform CONSYS bring-up synchronously now");
