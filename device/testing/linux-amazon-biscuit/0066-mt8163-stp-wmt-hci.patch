+int mt8163_consys_acquire(struct device *dev)
+{
+	struct mt8163_consys *priv = dev_get_drvdata(dev);
+	int ret = 0;
+
+	if (!priv)
+		return -EPROBE_DEFER;
+
+	mutex_lock(&priv->state_lock);
+	if (!priv->powered) {
+		ret = mt8163_consys_power_up(priv);
+		if (ret)
+			goto out;
+	}
+
+	if (!priv->cpu_released) {
+		ret = reset_control_deassert(priv->cpu_reset);
+		if (ret) {
+			dev_err(priv->dev, "failed to release CPU for radio client: %d\n",
+				ret);
+			goto out;
+		}
+		priv->cpu_released = true;
+		msleep(20);
+	}
+
+	priv->users++;
+out:
+	mutex_unlock(&priv->state_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt8163_consys_acquire);
+
+void mt8163_consys_release(struct device *dev)
+{
+	struct mt8163_consys *priv = dev_get_drvdata(dev);
+
+	if (!priv)
+		return;
+
+	mutex_lock(&priv->state_lock);
+	if (WARN_ON(!priv->users))
+		goto out;
+	priv->users--;
+out:
+	mutex_unlock(&priv->state_lock);
+}
+EXPORT_SYMBOL_GPL(mt8163_consys_release);
