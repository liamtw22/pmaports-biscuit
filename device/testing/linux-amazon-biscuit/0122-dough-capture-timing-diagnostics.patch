+/* Cached per-stream counters. No raw_read/fpga_status SPI transaction here. */
+static ssize_t capture_timing_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct dough_priv *priv = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&priv->lock);
+	len = sysfs_emit(buf,
+		"reads %llu max_gap_us %llu max_read_deliver_us %llu gap_over_16ms %llu read_deliver_over_8ms %llu full_reads %llu reported_excess_frames %llu overrun_flags %llu poll_us %u\n",
+		(unsigned long long)priv->timing_reads,
+		(unsigned long long)(priv->timing_max_gap_ns / 1000),
+		(unsigned long long)(priv->timing_max_transfer_ns / 1000),
+		(unsigned long long)priv->timing_gap_over_16ms,
+		(unsigned long long)priv->timing_transfer_over_8ms,
+		(unsigned long long)priv->timing_full_reads,
+		(unsigned long long)priv->timing_excess_frames,
+		(unsigned long long)priv->timing_overrun_flags,
+		READ_ONCE(capture_poll_us));
+	mutex_unlock(&priv->lock);
+	return len;
+}
+static DEVICE_ATTR_RO(capture_timing);
