 #define DOUGH_POLL_US		6000
 #define DOUGH_POLL_MAX_US	7000
+/* Root-only runtime trial knob; retain the shipped 6--7 ms policy by default. */
+static unsigned int capture_poll_us = DOUGH_POLL_US;
+
+static int dough_poll_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int candidate;
+	int ret = kstrtouint(val, 0, &candidate);
+
+	if (ret)
+		return ret;
+	if (candidate < 500 || candidate > DOUGH_POLL_US)
+		return -ERANGE;
+	WRITE_ONCE(*(unsigned int *)kp->arg, candidate);
+	return 0;
+}
+
+static const struct kernel_param_ops dough_poll_ops = {
+	.set = dough_poll_set,
+	.get = param_get_uint,
+};
+module_param_cb(capture_poll_us, &dough_poll_ops, &capture_poll_us, 0644);
+MODULE_PARM_DESC(capture_poll_us, "Capture poll minimum (500..6000 us; upper slack 1000 us)");
+
