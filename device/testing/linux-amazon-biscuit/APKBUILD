prepare() {
	default_prepare

	# The microphone array depends on all three pieces of the shared-TDM
	# implementation surviving the complete patch series.  Fail the build
	# instead of silently shipping a codec that cannot register or emits
	# 16-bit words into the FPGA's 24-bit slots.
	grep -Fq 'case SND_SOC_DAIFMT_DSP_B | SND_SOC_DAIFMT_NB_NF:' \
		"$builddir/sound/soc/codecs/tlv320adc3xxx.c"
	grep -Fq 'if (adc3xxx->tdm_slot_width == 24)' \
		"$builddir/sound/soc/codecs/tlv320adc3xxx.c"
	grep -Fq 'ADC3XXX_WLENGTH_MASK, iface_len);' \
		"$builddir/sound/soc/codecs/tlv320adc3xxx.c"
	grep -Fq 'return ret < 0 ? ret : 0;' \
		"$builddir/sound/soc/codecs/tlv320adc3xxx.c"

	# Wi-Fi: the MT6625L driver, imported as a tarball rather than a patch
	# because it is 169,459 lines of third-party source. Only the wiring
	# into its parent directory is ours.
	mkdir -p "$builddir/drivers/net/wireless/mediatek/mt6625l"
	cp -r "$srcdir"/mt6625l/* "$builddir/drivers/net/wireless/mediatek/mt6625l/"
	grep -q mt6625l "$builddir/drivers/net/wireless/mediatek/Kconfig" || \
		echo 'source "drivers/net/wireless/mediatek/mt6625l/Kconfig"' \
			>> "$builddir/drivers/net/wireless/mediatek/Kconfig"
	grep -q mt6625l "$builddir/drivers/net/wireless/mediatek/Makefile" || \
		echo 'obj-$(CONFIG_MT6625L_WLAN) += mt6625l/' \
			>> "$builddir/drivers/net/wireless/mediatek/Makefile"

	sed -i '/#include <dt-bindings\/clock\/mediatek,mt8163-audsys.h>/a #include <dt-bindings/thermal/thermal.h>' \
		"$builddir/arch/arm64/boot/dts/mediatek/mt8163.dtsi"
}

build() {
	unset LDFLAGS
	# No vendor firmware is compiled in any more.
	#
	# The FPGA bitstream and the two Bluetooth ROM patches used to be copied
	# into the source tree and compiled in through CONFIG_EXTRA_FIRMWARE, so
	# they were inside the kernel image - and therefore inside any prebuilt
	# image shipped from it. CONFIG_EXTRA_FIRMWARE is now empty. They are
	# MediaTek's and Amazon's, not ours, so they are now owner-imported like
	# the audio coefficients.
	#
	# They still have to exist before the root filesystem does, because the
	# drivers that want them are built in and ask during device_initcall
	# (t=0.61 s for the FPGA, t=0.93-1.00 s for Bluetooth) while the root
	# filesystem arrives at t=7.4 s. The initramfs is the answer: the kernel
	# unpacks it at rootfs_initcall, before device_initcall. The device
	# package's -nonfree-firmware subpackage lists them in
	# /usr/share/mkinitfs/files so mkinitfs puts the owner's copies in the
	# cpio.
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" defconfig
	# CONFIG_BT_RFCOMM is why HFP (hands-free calling) never worked, and the
	# cause took a long time to find because it looks nothing like an audio
	# problem. HFP carries its AT-command control channel over RFCOMM, which
	# arm64 defconfig does not enable at all - not even as a module. BlueZ
	# therefore cannot open its server socket:
	#
	#   profile.c:ext_start_servers() RFCOMM server failed:
	#       socket(STREAM, RFCOMM): Protocol not supported (93)
	#
	# With no socket it publishes no SDP record, so a phone never offers to
	# route calls here, however the profile is registered. A2DP hid the gap
	# completely: it runs over L2CAP/AVDTP and never touches RFCOMM.
	#
	# The open item blamed the missing BTCVSD driver and SCO routing. Both were
	# red herrings - SCO is the AUDIO channel, and the control channel never got
	# far enough to need it.
	#
	# SCO audio is that separate problem, and BTCVSD is its answer. With
	# RFCOMM in place, two real calls established a SCO link that carried
	# zero HCI packets in either direction: this controller does not send
	# call audio over HCI at all, it leaves CVSD/mSBC frames in a shared
	# SRAM bank. Stock drove the same block - its defconfig sets
	# CONFIG_MTK_BTCVSD - and mainline carries a driver for it whose
	# binding example matches MT8163's addresses and offsets exactly.
	#
	# USB Audio Class gadget (UAC1 and UAC2). The board already runs a USB
	# gadget - that is what usb0 is - so this adds a function to an existing
	# composite rather than a new subsystem. It exists because the mic array
	# on this device is genuinely good, and Bluetooth is a poor way to reach
	# it: HFP caps out at 8 kHz CVSD or 16 kHz mSBC, forces the device out of
	# A2DP while the mic is live, and depends on host-specific SCO behaviour
	# that took a whole session to characterise on Windows alone. USB has
	# none of those problems - 48 kHz, no pairing, no codec negotiation.
	#
	# Both classes are enabled deliberately. UAC2 is the better transport and
	# Windows 10+, macOS and Linux all take it without a driver; UAC1 is the
	# fallback for hosts that handle UAC2 badly, and costs a few KB. Which one
	# a given host gets is a runtime choice in configfs, so having both means
	# the decision does not need another 90 minute kernel build to revisit.
	"$builddir/scripts/config" --file "$builddir/$_outdir/.config" \
		--enable CONFIG_SYN_COOKIES \
		--enable CONFIG_BT_RFCOMM \
		--enable CONFIG_BT_RFCOMM_TTY \
		--enable CONFIG_SND_SOC_MTK_BTCVSD \
		--enable CONFIG_USB_CONFIGFS_F_UAC1 \
		--enable CONFIG_USB_CONFIGFS_F_UAC2 \
		--disable CONFIG_DRM \
		--disable CONFIG_PHY_MTK_MIPI_DSI \
		--disable CONFIG_EFI \
		--disable CONFIG_ATA \
		--disable CONFIG_SCSI_UFSHCD \
		--disable CONFIG_XEN \
		--disable CONFIG_STRICT_DEVMEM \
		--disable CONFIG_MEDIA_SUPPORT \
		--disable CONFIG_INFINIBAND \
		--disable CONFIG_ARCH_ACTIONS \
		--disable CONFIG_ARCH_AIROHA \
		--disable CONFIG_ARCH_SUNXI \
		--disable CONFIG_ARCH_ALPINE \
		--disable CONFIG_ARCH_APPLE \
		--disable CONFIG_ARCH_ARTPEC \
		--disable CONFIG_ARCH_AXIADO \
		--disable CONFIG_ARCH_BCM \
		--disable CONFIG_ARCH_BCM2835 \
		--disable CONFIG_ARCH_BCM_IPROC \
		--disable CONFIG_ARCH_BCMBCA \
		--disable CONFIG_ARCH_BRCMSTB \
		--disable CONFIG_ARCH_BERLIN \
		--disable CONFIG_ARCH_BLAIZE \
		--disable CONFIG_ARCH_BST \
		--disable CONFIG_ARCH_CIX \
		--disable CONFIG_ARCH_EXYNOS \
		--disable CONFIG_ARCH_K3 \
		--disable CONFIG_ARCH_LG1K \
		--disable CONFIG_ARCH_HISI \
		--disable CONFIG_ARCH_KEEMBAY \
		--disable CONFIG_ARCH_MESON \
		--disable CONFIG_ARCH_MICROCHIP \
		--disable CONFIG_ARCH_SPARX5 \
		--disable CONFIG_ARCH_MVEBU \
		--disable CONFIG_ARCH_NXP \
		--disable CONFIG_ARCH_LAYERSCAPE \
		--disable CONFIG_ARCH_MXC \
		--disable CONFIG_ARCH_S32 \
		--disable CONFIG_ARCH_MA35 \
		--disable CONFIG_ARCH_NPCM \
		--disable CONFIG_ARCH_QCOM \
		--disable CONFIG_ARCH_REALTEK \
		--disable CONFIG_ARCH_RENESAS \
		--disable CONFIG_ARCH_ROCKCHIP \
		--disable CONFIG_ARCH_SEATTLE \
		--disable CONFIG_ARCH_INTEL_SOCFPGA \
		--disable CONFIG_ARCH_SOPHGO \
		--disable CONFIG_ARCH_STM32 \
		--disable CONFIG_ARCH_SYNQUACER \
		--disable CONFIG_ARCH_TEGRA \
		--disable CONFIG_ARCH_TESLA_FSD \
		--disable CONFIG_ARCH_SPRD \
		--disable CONFIG_ARCH_THUNDER \
		--disable CONFIG_ARCH_THUNDER2 \
		--disable CONFIG_ARCH_UNIPHIER \
		--disable CONFIG_ARCH_VEXPRESS \
		--disable CONFIG_ARCH_VISCONTI \
		--disable CONFIG_ARCH_XGENE \
		--disable CONFIG_ARCH_ZYNQMP \
		--disable CONFIG_ETHERNET \
		--disable CONFIG_SCSI_SAS_ATTRS \
		--disable CONFIG_MEGARAID_SAS \
		--disable CONFIG_VFIO \
		--disable CONFIG_IPMI_HANDLER \
		--disable CONFIG_SND_SOC_QCOM \
		--disable CONFIG_SND_SOC_TEGRA \
		--disable CONFIG_SND_SOC_SOF_TOPLEVEL \
		--enable CONFIG_MTK_PMIC_WRAP \
		--enable CONFIG_MFD_MT6397 \
		--enable CONFIG_REGULATOR_MT6323 \
		--set-val CONFIG_REGULATOR_FIXED_VOLTAGE y \
		--enable CONFIG_RTC_DRV_MT6397 \
		--enable CONFIG_SOUND \
		--enable CONFIG_SND \
		--enable CONFIG_SND_PCM \
		--enable CONFIG_SND_SOC \
		--enable CONFIG_SND_SOC_MT8163 \
		--set-val CONFIG_SND_SOC_TLV320AIC32X4_I2C y \
		--enable CONFIG_NOP_USB_XCEIV \
		--enable CONFIG_USB_MUSB_HDRC \
		--enable CONFIG_USB_MUSB_GADGET \
		--disable CONFIG_USB_MUSB_HOST \
		--enable CONFIG_USB_MUSB_MEDIATEK \
		--enable CONFIG_USB_INVENTRA_DMA \
		--enable CONFIG_USB_CONFIGFS \
		--enable CONFIG_USB_CONFIGFS_RNDIS \
		--enable CONFIG_USB_CONFIGFS_OS_DESC \
		--enable CONFIG_ZRAM \
		--enable CONFIG_SPI \
		--enable CONFIG_SPI_MT65XX \
		--enable CONFIG_SPI_SPIDEV \
		--enable CONFIG_DOUGH_FPGA \
		--enable CONFIG_SND_SOC_TLV320ADC3XXX \
		--enable CONFIG_NEW_LEDS \
		--enable CONFIG_LEDS_CLASS \
		--enable CONFIG_LEDS_CLASS_MULTICOLOR \
		--enable CONFIG_LEDS_IS31FL32XX \
		--enable CONFIG_IIO \
		--enable CONFIG_TSL2583 \
		--enable CONFIG_MT8163_CONSYS \
		--set-val CONFIG_BT y \
		--set-val CONFIG_BT_HCI_MT8163_STP y \
		--enable CONFIG_MFD_SYSCON \
		--enable CONFIG_MT8163_BTIF \
		--enable CONFIG_RFKILL \
		--enable CONFIG_CC_OPTIMIZE_FOR_SIZE
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" olddefconfig
	"$builddir/scripts/config" --file "$builddir/$_outdir/.config" \
		--enable CONFIG_LEDS_CLASS_MULTICOLOR \
		--enable CONFIG_LEDS_IS31FL32XX \
		--enable CONFIG_MT8163_CONSYS \
		--enable CONFIG_MT8163_BTIF \
		--enable CONFIG_RFKILL \
		--enable CONFIG_REGMAP_MMIO \
		--enable CONFIG_INPUT_MATRIXKMAP \
		--enable CONFIG_KEYBOARD_MT6779 \
		--enable CONFIG_KEYBOARD_MTK_PMIC \
		--enable CONFIG_MTK_THERMAL \
		--enable CONFIG_MTK_SOC_THERMAL \
		--set-val CONFIG_MEDIATEK_MT6577_AUXADC y \
		--enable CONFIG_CFG80211 \
		--enable CONFIG_NL80211_TESTMODE \
		--enable CONFIG_CFG80211_WEXT \
		--set-val CONFIG_MT6625L_WLAN m
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" KCFLAGS="-Wno-error=incompatible-pointer-types" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" KCFLAGS="-Wno-error=incompatible-pointer-types" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS" \
		mediatek/$_dtb.dtb
}

package() {
	KERNEL_IMAGE_NAME="Image.gz" \
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"
	install -Dm644 "$builddir/$_outdir/arch/arm64/boot/dts/mediatek/$_dtb.dtb" \
		"$pkgdir/usr/share/dtb/$_dtb.dtb"

	# downstreamkernel_package installs the image and kernel.release only.
	# Every revision up to r193 was fully built-in so that was enough; r194
	# is the first with a loadable module (the MT6625L WLAN driver) and it
	# would otherwise be dropped on the floor.
	make -C "$builddir" O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		INSTALL_MOD_PATH="$pkgdir" INSTALL_MOD_STRIP=1 \
		DEPMOD=/bin/true modules_install

	# WLAN firmware is OWNER-IMPORTED and is deliberately not shipped.
	#
	# It is MediaTek's, not ours, and its redistribution terms are not
	# established - the same reason the Fire OS audio coefficients are not
	# here. The owner exports it before conversion with
	# tools/export_stock_assets.py and installs it with
	#     biscuit-import-assets import <export> --profile firmware
	# which verifies it by hash and links it to /lib/firmware/WIFI_RAM_CODE,
	# the bare name the driver requests (CFG_FW_FILENAME has no chip suffix).
	#
	# This works ONLY because wlan_mt6625l is a loadable module that comes up
	# around t=35 s, long after the root filesystem at t=7.4 s. The Bluetooth
	# ROM patches and the FPGA bitstream are requested by BUILT-IN drivers at
	# t=0.9-1.2 s and t=0.61 s, before any filesystem exists, so they cannot
	# take this route: the owner's copies travel in the initramfs instead,
	# listed by the device package's -nonfree-firmware subpackage (see build()
	# above and PROVENANCE.md).
	#
	# Without the import the WLAN driver probes and dies at
	# kalFirmwareImageMapping, which is the intended, visible failure.
}

