+static u16 mt8163_stp_crc16(const u8 *buf, size_t len)
+{
+	u16 crc = 0;
+	unsigned int bit;
+
+	while (len--) {
+		crc ^= *buf++;
+		for (bit = 0; bit < 8; bit++)
+			crc = (crc & 1) ? (crc >> 1) ^ 0xa001 : crc >> 1;
+	}
+
+	return crc;
+}
