+static void mt8163_stp_finish_frame(struct mt8163_stp *stp)
+{
+	u16 expected_crc, received_crc;
+	u8 previous_seq;
+
+	if (stp->mode == MT8163_STP_MODE_MANDATORY) {
+		if (stp->payload[stp->payload_need] ||
+		    stp->payload[stp->payload_need + 1]) {
+			dev_warn_ratelimited(stp->dev,
+					 "non-zero mandatory STP trailer\n");
+			return;
+		}
+		mt8163_stp_deliver_payload(stp);
+		return;
+	}
+
+	received_crc = stp->payload[stp->payload_need] |
+		       (stp->payload[stp->payload_need + 1] << 8);
+	expected_crc = mt8163_stp_crc16(stp->payload, stp->payload_need);
+	if (received_crc != expected_crc) {
+		dev_warn_ratelimited(stp->dev,
+				 "full STP CRC mismatch: got 0x%04x expected 0x%04x\n",
+				 received_crc, expected_crc);
+		mt8163_stp_send_ack(stp);
+		return;
+	}
+
+	mt8163_stp_process_ack(stp, stp->payload_ack);
+	if (stp->payload_seq == stp->expected_rxseq) {
+		stp->txack = stp->payload_seq;
+		stp->expected_rxseq = (stp->expected_rxseq + 1) & 0x7;
+		mt8163_stp_send_ack(stp);
+		mt8163_stp_deliver_payload(stp);
+		return;
+	}
+
+	previous_seq = (stp->expected_rxseq - 1) & 0x7;
+	if (stp->payload_seq != previous_seq)
+		dev_warn_ratelimited(stp->dev,
+				 "unexpected full STP sequence %u, expected %u\n",
+				 stp->payload_seq, stp->expected_rxseq);
+
+	/* Acknowledge the last accepted frame for duplicates and out-of-order RX. */
+	mt8163_stp_send_ack(stp);
+}
