--- /dev/null
+++ b/arch/arm64/kernel/mt8163-smp.c
@@ -0,0 +1,213 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Secondary CPU bring-up for Amazon Biscuit (MT8163).
+ *
+ * Firmware accepts PSCI CPU_ON but does not power CPUs 1-3. Use the vendor
+ * INFRACFG boot vector and bounded SPM MTCMOS power-on sequence instead.
+ */
+#include <linux/bitops.h>
+#include <linux/cpumask.h>
+#include <linux/init.h>
+#include <linux/jiffies.h>
+#include <linux/workqueue.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/psci.h>
+
+#include <asm/cpu_ops.h>
+#include <asm/memory.h>
+#include <asm/smp_plat.h>
+
+#define MT8163_INFRACFG_AO          0x10001000
+#define MT8163_BOOTADDR             0x800
+#define MT8163_SPM                  0x10006000
+
+#define SPM_POWERON_CONFIG_SET      0x000
+#define SPM_CA7_CPU1_PWR_CON        0x218
+#define SPM_CA7_CPU2_PWR_CON        0x21c
+#define SPM_CA7_CPU3_PWR_CON        0x220
+#define SPM_CA7_CPU1_L1_PDN         0x264
+#define SPM_CA7_CPU2_L1_PDN         0x26c
+#define SPM_CA7_CPU3_L1_PDN         0x274
+#define SPM_PWR_STATUS              0x60c
+#define SPM_PWR_STATUS_2ND          0x610
+
+#define SPM_PROJECT_CODE            0x0b16
+#define PWR_RST_B                   BIT(0)
+#define PWR_ISO                     BIT(1)
+#define PWR_ON                      BIT(2)
+#define PWR_ON_2ND                  BIT(3)
+#define PWR_CLK_DIS                 BIT(4)
+#define SRAM_CKISO                  BIT(5)
+#define SRAM_ISOINT_B               BIT(6)
+#define L1_PDN                      BIT(0)
+#define L1_PDN_ACK                  BIT(8)
+
+struct mt8163_cpu_power {
+	u32 pwr_con;
+	u32 l1_pdn;
+	u32 status_mask;
+};
+
+static const struct mt8163_cpu_power mt8163_cpu_power[] = {
+	[1] = { SPM_CA7_CPU1_PWR_CON, SPM_CA7_CPU1_L1_PDN, BIT(10) },
+	[2] = { SPM_CA7_CPU2_PWR_CON, SPM_CA7_CPU2_L1_PDN, BIT(11) },
+	[3] = { SPM_CA7_CPU3_PWR_CON, SPM_CA7_CPU3_L1_PDN, BIT(12) },
+};
+
+static int mt8163_cpu_init(unsigned int cpu)
+{
+	if (cpu == 0 || cpu >= ARRAY_SIZE(mt8163_cpu_power))
+		return -EINVAL;
+
+	return 0;
+}
+
+static int mt8163_cpu_prepare(unsigned int cpu)
+{
+	if (cpu == 0 || cpu >= ARRAY_SIZE(mt8163_cpu_power))
+		return -EINVAL;
+
+	return 0;
+}
+
+static int mt8163_wait_for(void __iomem *spm, u32 offset, u32 mask,
+			   u32 expected, unsigned int cpu, const char *what)
+{
+	unsigned int i;
+	u32 value = 0;
+
+	for (i = 0; i < 100000; i++) {
+		value = readl(spm + offset);
+		if ((value & mask) == expected)
+			return 0;
+		udelay(1);
+	}
+
+	pr_err("MT8163-SMP: CPU%u timeout waiting for %s: got=%#x mask=%#x expected=%#x\n",
+	       cpu, what, value, mask, expected);
+	return -ETIMEDOUT;
+}
+
+static int mt8163_cpu_boot(unsigned int cpu)
+{
+	const struct mt8163_cpu_power *p;
+	void __iomem *infra;
+	void __iomem *spm;
+	int ret, psci_ret;
+	phys_addr_t entry;
+
+	ret = mt8163_cpu_prepare(cpu);
+	if (ret)
+		return ret;
+
+	p = &mt8163_cpu_power[cpu];
+	entry = __pa_symbol(secondary_entry);
+	if ((u64)entry >> 32) {
+		pr_err("MT8163-SMP: secondary entry does not fit boot vector: %pa\n",
+		       &entry);
+		return -ERANGE;
+	}
+	
+	infra = ioremap(MT8163_INFRACFG_AO, 0x1000);
+	spm = ioremap(MT8163_SPM, 0x1000);
+	if (!infra || !spm) {
+		pr_err("MT8163-SMP: CPU%u could not map INFRACFG/SPM\n", cpu);
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	pr_info("MT8163-SMP: CPU%u pre-power pwr=%#x l1=%#x sta=%#x sta2=%#x entry=%pa\n",
+		cpu, readl(spm + p->pwr_con), readl(spm + p->l1_pdn),
+		readl(spm + SPM_PWR_STATUS), readl(spm + SPM_PWR_STATUS_2ND),
+		&entry);
+
+	/*
+	 * This MT8163 boot-address register is write-only: the vendor kernel
+	 * writes it without readback. PSCI prepares secure state before MTCMOS.
+	 */
+	writel((u32)entry, infra + MT8163_BOOTADDR);
+	if (!psci_ops.cpu_on) {
+		pr_err("MT8163-SMP: CPU%u PSCI CPU_ON is unavailable\n", cpu);
+		ret = -ENODEV;
+		goto out;
+	}
+
+	psci_ret = psci_ops.cpu_on(cpu_logical_map(cpu), entry);
+	pr_info("MT8163-SMP: CPU%u PSCI_CPU_ON entry=%pa ret=%d\n",
+		cpu, &entry, psci_ret);
+	if (psci_ret) {
+		ret = psci_ret;
+		goto out;
+	}
+
+	/* Vendor spm_mtcmos_ctrl_cpu[1-3](STA_POWER_ON, 1). */
+	writel((SPM_PROJECT_CODE << 16) | BIT(0),
+	       spm + SPM_POWERON_CONFIG_SET);
+	writel(readl(spm + p->pwr_con) | PWR_ON, spm + p->pwr_con);
+	udelay(1);
+	writel(readl(spm + p->pwr_con) | PWR_ON_2ND, spm + p->pwr_con);
+
+	ret = mt8163_wait_for(spm, SPM_PWR_STATUS, p->status_mask,
+			      p->status_mask, cpu, "SPM_PWR_STATUS");
+	if (ret)
+		goto out;
+	ret = mt8163_wait_for(spm, SPM_PWR_STATUS_2ND, p->status_mask,
+			      p->status_mask, cpu, "SPM_PWR_STATUS_2ND");
+	if (ret)
+		goto out;
+
+	writel(readl(spm + p->pwr_con) & ~PWR_ISO, spm + p->pwr_con);
+	writel(readl(spm + p->l1_pdn) & ~L1_PDN, spm + p->l1_pdn);
+
+	ret = mt8163_wait_for(spm, p->l1_pdn, L1_PDN_ACK, 0,
+			      cpu, "L1_PDN_ACK clear");
+	if (ret)
+		goto out;
+
+	udelay(1);
+	writel(readl(spm + p->pwr_con) | SRAM_ISOINT_B, spm + p->pwr_con);
+	writel(readl(spm + p->pwr_con) & ~SRAM_CKISO, spm + p->pwr_con);
+	writel(readl(spm + p->pwr_con) & ~PWR_CLK_DIS, spm + p->pwr_con);
+	writel(readl(spm + p->pwr_con) | PWR_RST_B, spm + p->pwr_con);
+
+	pr_info("MT8163-SMP: CPU%u released pwr=%#x l1=%#x sta=%#x sta2=%#x\n",
+		cpu, readl(spm + p->pwr_con), readl(spm + p->l1_pdn),
+		readl(spm + SPM_PWR_STATUS), readl(spm + SPM_PWR_STATUS_2ND));
+	ret = 0;
+out:
+	if (spm)
+		iounmap(spm);
+	if (infra)
+		iounmap(infra);
+	return ret;
+}
+
+/*
+ * Report after the initial console burst has subsided. This is read-only
+ * diagnostics and does not alter secondary-CPU power sequencing.
+ */
+static void mt8163_smp_report_online(struct work_struct *work)
+{
+	pr_info("MT8163-SMP: delayed online CPUs=%*pbl count=%u\n",
+		cpumask_pr_args(cpu_online_mask), num_online_cpus());
+}
+
+static DECLARE_DELAYED_WORK(mt8163_smp_online_work,
+			    mt8163_smp_report_online);
+
+static int mt8163_smp_schedule_online_report(void)
+{
+	schedule_delayed_work(&mt8163_smp_online_work, msecs_to_jiffies(15000));
+	return 0;
+}
+late_initcall(mt8163_smp_schedule_online_report);
+
+const struct cpu_operations mt8163_smp_ops = {
+	.name		= "mediatek,mt8163-smp",
+	.cpu_init	= mt8163_cpu_init,
+	.cpu_prepare	= mt8163_cpu_prepare,
+	.cpu_boot	= mt8163_cpu_boot,
+};
