+int mt8163_consys_bt_paldo_set(struct device *dev, bool on)
+{
+	struct mt8163_consys *priv = dev_get_drvdata(dev);
+	int ret = 0;
+
+	if (!priv)
+		return -EPROBE_DEFER;
+
+	mutex_lock(&priv->state_lock);
+	if (!priv->powered) {
+		ret = -EHOSTDOWN;
+		goto out;
+	}
+
+	if (on)
+		ret = mt8163_consys_enable_supply(priv, MT8163_CONSYS_VCN33_BT,
+						  3300000);
+	else
+		mt8163_consys_disable_supply(priv, MT8163_CONSYS_VCN33_BT);
+out:
+	mutex_unlock(&priv->state_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt8163_consys_bt_paldo_set);
