+static int mt8163_consys_enable_supply(struct mt8163_consys *priv,
+					       enum mt8163_consys_supply supply,
+					       int microvolts)
+{
+	struct regulator *reg = priv->supplies[supply].consumer;
+	int ret;
+
+	if (priv->supply_enabled[supply])
+		return 0;
+
+	ret = regulator_set_voltage(reg, microvolts, microvolts);
+	if (ret)
+		return dev_err_probe(priv->dev, ret, "failed to set %s voltage\n",
+				     priv->supplies[supply].supply);
+
+	ret = regulator_enable(reg);
+	if (ret)
+		return dev_err_probe(priv->dev, ret, "failed to enable %s\n",
+				     priv->supplies[supply].supply);
+
+	priv->supply_enabled[supply] = true;
+	return 0;
+}
+
+static void mt8163_consys_disable_supply(struct mt8163_consys *priv,
+					  enum mt8163_consys_supply supply)
+{
+	int ret;
+
+	if (!priv->supply_enabled[supply])
+		return;
+
+	ret = regulator_disable(priv->supplies[supply].consumer);
+	if (ret)
+		dev_warn(priv->dev, "failed to disable %s: %d\n",
+			 priv->supplies[supply].supply, ret);
+	else
+		priv->supply_enabled[supply] = false;
+}
+
+static void mt8163_consys_disable_all_supplies(struct mt8163_consys *priv)
+{
+	mt8163_consys_disable_supply(priv, MT8163_CONSYS_VCN33_BT);
+	mt8163_consys_disable_supply(priv, MT8163_CONSYS_VCN28);
+	mt8163_consys_disable_supply(priv, MT8163_CONSYS_VCN18);
+}
