+static void mt8163_btif_hw_disable(struct mt8163_btif *btif)
+{
+	writel(0, btif->tx.base + DMA_INT_EN);
+	writel(0, btif->rx.base + DMA_INT_EN);
+	writel(0, btif->tx.base + DMA_EN);
+	writel(0, btif->rx.base + DMA_EN);
+	writel(0, btif->base + BTIF_DMA_EN);
+}
+
+int mt8163_btif_start(struct mt8163_btif *btif)
+{
+	u32 value;
+	int ret;
+
+	if (!btif)
+		return -EINVAL;
+
+	mutex_lock(&btif->state_lock);
+	if (btif->active) {
+		ret = 0;
+		goto out_unlock;
+	}
+
+	ret = clk_prepare_enable(btif->btif_clk);
+	if (ret)
+		goto out_unlock;
+
+	ret = clk_prepare_enable(btif->apdma_clk);
+	if (ret)
+		goto err_btif_clock;
+
+	ret = request_irq(btif->tx.irq, mt8163_btif_dma_irq, IRQF_NO_THREAD,
+			  "mt8163-btif-tx", &btif->tx);
+	if (ret)
+		goto err_apdma_clock;
+	btif->tx_irq_requested = true;
+
+	ret = request_irq(btif->rx.irq, mt8163_btif_dma_irq, IRQF_NO_THREAD,
+			  "mt8163-btif-rx", &btif->rx);
+	if (ret)
+		goto err_tx_irq;
+	btif->rx_irq_requested = true;
+
+	/* The vendor programs the controller before enabling either DMA engine. */
+	writel(0, btif->base + BTIF_FAKELCR);
+	value = readl(btif->base + BTIF_HANDSHAKE);
+	writel(value | BTIF_HANDSHAKE_ENABLE, btif->base + BTIF_HANDSHAKE);
+	writel(BTIF_TRI_LVL_TX(BTIF_TX_FIFO_THRESHOLD) |
+		BTIF_TRI_LVL_RX(BTIF_RX_FIFO_THRESHOLD),
+		btif->base + BTIF_TRI_LVL);
+	writel(BTIF_DMA_EN_AUTORST, btif->base + BTIF_DMA_EN);
+	writel(0, btif->base + BTIF_IER);
+
+	ret = mt8163_btif_dma_setup(btif, &btif->tx);
+	if (ret)
+		goto err_hw;
+
+	ret = mt8163_btif_dma_setup(btif, &btif->rx);
+	if (ret)
+		goto err_hw;
+
+	WRITE_ONCE(btif->active, true);
+	dev_info(btif->dev, "BTIF DMA transport active after CONSYS acquire\n");
+	ret = 0;
+	goto out_unlock;
+
+err_hw:
+	mt8163_btif_hw_disable(btif);
+	free_irq(btif->rx.irq, &btif->rx);
+	btif->rx_irq_requested = false;
+err_tx_irq:
+	free_irq(btif->tx.irq, &btif->tx);
+	btif->tx_irq_requested = false;
+err_apdma_clock:
+	clk_disable_unprepare(btif->apdma_clk);
+err_btif_clock:
+	clk_disable_unprepare(btif->btif_clk);
+out_unlock:
+	mutex_unlock(&btif->state_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt8163_btif_start);
+
+void mt8163_btif_stop(struct mt8163_btif *btif)
+{
+	if (!btif)
+		return;
+
+	mutex_lock(&btif->state_lock);
+	if (!btif->active)
+		goto out_unlock;
+
+	WRITE_ONCE(btif->active, false);
+	mt8163_btif_hw_disable(btif);
+	if (btif->rx_irq_requested) {
+		free_irq(btif->rx.irq, &btif->rx);
+		btif->rx_irq_requested = false;
+	}
+	if (btif->tx_irq_requested) {
+		free_irq(btif->tx.irq, &btif->tx);
+		btif->tx_irq_requested = false;
+	}
+	clk_disable_unprepare(btif->apdma_clk);
+	clk_disable_unprepare(btif->btif_clk);
+
+out_unlock:
+	mutex_unlock(&btif->state_lock);
+}
+EXPORT_SYMBOL_GPL(mt8163_btif_stop);
