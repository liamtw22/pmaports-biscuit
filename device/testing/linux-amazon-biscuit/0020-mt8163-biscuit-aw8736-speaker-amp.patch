--- a/sound/soc/mediatek/mt8163/mt8163-biscuit.c
+++ b/sound/soc/mediatek/mt8163/mt8163-biscuit.c
@@ -6,12 +6,15 @@
  * the no-PCM backend that carries DL1 to the external TLV320 codec.
  */
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/gpio/consumer.h>
+#include <linux/delay.h>
 #include <linux/platform_device.h>
 #include <sound/soc.h>
 
 struct mt8163_biscuit_priv {
+	struct gpio_desc *speaker_amp;
 	struct snd_soc_card card;
 	struct snd_soc_dai_link links[2];
 	struct snd_soc_dai_link_component cpus[2];
 	struct snd_soc_dai_link_component platforms[2];
@@ -23,8 +26,61 @@
  * backend. Without this route, ASoC deliberately leaves the backend idle.
  */
 static const struct snd_soc_dapm_route mt8163_biscuit_routes[] = {
 	{ "I2S1", NULL, "DL1" },
+};
+
+/*
+ * Biscuit's vendor non-legacy path enables the external amplifier directly.
+ * AW8736 timed mode is optional there and is not enabled for Biscuit.
+ */
+static void mt8163_biscuit_speaker_amp(struct mt8163_biscuit_priv *priv, bool on)
+{
+       if (!priv->speaker_amp)
+               return;
+
+       if (!on) {
+               gpiod_set_value_cansleep(priv->speaker_amp, 0);
+               udelay(500);
+               return;
+       }
+
+       /* Vendor AW8736 Mode 3: three rising edges after a low reset. */
+       gpiod_set_value_cansleep(priv->speaker_amp, 0);
+       usleep_range(1000, 1200);
+       gpiod_set_value_cansleep(priv->speaker_amp, 1);
+       udelay(2);
+       gpiod_set_value_cansleep(priv->speaker_amp, 0);
+       udelay(2);
+       gpiod_set_value_cansleep(priv->speaker_amp, 1);
+       udelay(2);
+       gpiod_set_value_cansleep(priv->speaker_amp, 0);
+       udelay(2);
+       gpiod_set_value_cansleep(priv->speaker_amp, 1);
+       usleep_range(25000, 26000);
+       dev_info(priv->card.dev, "BISCUIT: AW8736 Mode 3 selected\n");
+}
+
+static int mt8163_biscuit_be_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct mt8163_biscuit_priv *priv = snd_soc_card_get_drvdata(rtd->card);
+
+	mt8163_biscuit_speaker_amp(priv, true);
+	return 0;
+}
+
+static void mt8163_biscuit_be_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct mt8163_biscuit_priv *priv = snd_soc_card_get_drvdata(rtd->card);
+
+	mt8163_biscuit_speaker_amp(priv, false);
+}
+
+static const struct snd_soc_ops mt8163_biscuit_be_ops = {
+	.startup = mt8163_biscuit_be_startup,
+	.shutdown = mt8163_biscuit_be_shutdown,
 };
 
 static int mt8163_biscuit_probe(struct platform_device *pdev)
 {
@@ -42,8 +79,13 @@
 				     "missing AFE or codec phandle\n");
 	}
 
 	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	priv->speaker_amp = devm_gpiod_get_optional(dev, "speaker-amp", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->speaker_amp))
+	        return dev_err_probe(dev, PTR_ERR(priv->speaker_amp),
+	                             "failed to get speaker amplifier GPIO\n");
+
 	if (!priv) {
 		of_node_put(afe_np);
 		of_node_put(codec_np);
 		return -ENOMEM;
@@ -90,14 +132,16 @@
 	priv->links[1].playback_only = 1;
 	priv->links[1].dai_fmt = SND_SOC_DAIFMT_I2S |
 		SND_SOC_DAIFMT_NB_NF |
 		SND_SOC_DAIFMT_CBC_CFC;
+	priv->links[1].ops = &mt8163_biscuit_be_ops;
 
 	priv->card.name = "mt8163-biscuit";
 	priv->card.owner = THIS_MODULE;
 	priv->card.dev = dev;
 	priv->card.dai_link = priv->links;
 	priv->card.num_links = ARRAY_SIZE(priv->links);
+	snd_soc_card_set_drvdata(&priv->card, priv);
 	priv->card.dapm_routes = mt8163_biscuit_routes;
 	priv->card.num_dapm_routes = ARRAY_SIZE(mt8163_biscuit_routes);
 
 	ret = devm_snd_soc_register_card(dev, &priv->card);
--- a/arch/arm64/boot/dts/mediatek/mt8163-amazon-biscuit.dts
