+/*
+ * Where this converter's samples sit in a shared frame, counted in bit clocks
+ * from the frame sync. tx_mask selects the slots it drives; the first of them
+ * is where its left channel starts, and the right channel follows on its own.
+ * DSP_A delays the whole frame by one bit clock, which the same register has
+ * to absorb.
+ */
+static int adc3xxx_set_dai_tdm_slot(struct snd_soc_dai *dai,
+				    unsigned int tx_mask, unsigned int rx_mask,
+				    int slots, int slot_width)
+{
+	struct snd_soc_component *component = dai->component;
+	struct adc3xxx *adc3xxx = snd_soc_component_get_drvdata(component);
+	unsigned int offset, slot, disabled_channels;
+	u8 iface_len;
+	int ret;
+
+	if (!tx_mask || slots <= 0 || slot_width <= 0)
+		return -EINVAL;
+
+	switch (slot_width) {
+	case 16:
+		iface_len = ADC3XXX_IFACE_16BITS;
+		break;
+	case 20:
+		iface_len = ADC3XXX_IFACE_20BITS;
+		break;
+	case 24:
+		iface_len = ADC3XXX_IFACE_24BITS;
+		break;
+	case 32:
+		iface_len = ADC3XXX_IFACE_32BITS;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	slot = __ffs(tx_mask);
+	if (slot + 1 >= slots)
+		return -EINVAL;
+
+	offset = slot * slot_width + adc3xxx->dsp_delay;
+	if (offset > 255)
+		return -EINVAL;
+
+	ret = snd_soc_component_write(component, ADC3XXX_CH_OFFSET_1, offset);
+	if (ret < 0)
+		return ret;
+
+	/* Keep the serial word as wide as the physical shared-bus slot. */
+	ret = snd_soc_component_update_bits(component,
+					    ADC3XXX_INTERFACE_CTRL_1,
+					    ADC3XXX_WLENGTH_MASK, iface_len);
+	if (ret < 0)
+		return ret;
+
+	adc3xxx->tdm_slots = slots;
+	adc3xxx->tdm_slot_width = slot_width;
+
+	/*
+	 * The TLV320 field is active-low: a set bit disables the matching
+	 * converter channel.  rx_mask is expressed in frame slots, so select
+	 * the two slots owned by this converter.  This matches the vendor
+	 * driver's 0x7f seven-microphone configuration: ADCs A-C stay stereo
+	 * and ADC D receives 0x0a (only its populated slot is driven).
+	 */
+	disabled_channels = ~(rx_mask >> slot) & 0x3;
+
+	ret = snd_soc_component_update_bits(component, ADC3XXX_I2S_TDM_CTRL,
+					    ADC3XXX_TDM_EARLY_3STATE |
+					    ADC3XXX_TDM_CHANNEL_EN_MASK,
+					    ADC3XXX_TDM_EARLY_3STATE |
+					    (disabled_channels <<
+					     ADC3XXX_TDM_CHANNEL_EN_SHIFT));
+
+	/* update_bits returns one when it changed the register, not an error. */
+	return ret < 0 ? ret : 0;
+}
