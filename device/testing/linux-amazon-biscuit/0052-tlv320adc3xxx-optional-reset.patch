-	bdiv = (adc3xxx_divs[i].aosr * adc3xxx_divs[i].madc) / (2 * width);
-	snd_soc_component_update_bits(component, ADC3XXX_BCLK_N_DIV,
-				      ADC3XXX_BDIV_MASK, bdiv);
+	/*
+	 * BDIV N Value. Only meaningful when this device drives the bit
+	 * clock; as a consumer it takes the clock as it arrives, and may
+	 * be deriving its own clocks from it.
+	 */
+	if (adc3xxx->master) {
+		bdiv = (adc3xxx_divs[i].aosr * adc3xxx_divs[i].madc) /
+			(2 * width);
+		snd_soc_component_update_bits(component, ADC3XXX_BCLK_N_DIV,
+					      ADC3XXX_BDIV_MASK, bdiv);
+	}
 
