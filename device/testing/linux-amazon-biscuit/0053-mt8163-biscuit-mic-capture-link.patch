+/*
+ * The microphone ADCs have no master clock of their own: the FPGA drives
+ * the bus, and they run their PLL from the bit clock it provides. Eight
+ * 24 bit slots at 16 kHz is 3.072 MHz. Clock id 3 is the codec driver's
+ * ADC3XXX_PLL_BCLK, which selects that source.
+ */
+static int mt8163_biscuit_mic_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_dai *codec_dai;
+	int i, ret;
+
+	/*
+	 * None of the ADCs has a master clock: the FPGA drives the bus and
+	 * they run their PLL from the bit clock it provides. Eight 24 bit
+	 * slots at 16 kHz is 3.072 MHz. Clock id 3 is the codec driver's
+	 * ADC3XXX_PLL_BCLK, which selects that source.
+	 */
+	for_each_rtd_codec_dais(rtd, i, codec_dai) {
+		ret = snd_soc_dai_set_sysclk(codec_dai, 3, 3072000,
+					     SND_SOC_CLOCK_IN);
+		if (ret) {
+			dev_err(rtd->card->dev,
+				"failed to set the bit clock on %s: %d\n",
+				codec_dai->name, ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
