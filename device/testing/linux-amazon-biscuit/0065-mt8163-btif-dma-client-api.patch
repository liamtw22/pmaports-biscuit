+int mt8163_btif_write(struct mt8163_btif *btif, const u8 *buf, size_t len)
+{
+	struct mt8163_btif_dma *tx;
+	u32 left, valid, wpt, offset, wrap;
+	size_t first;
+	int ret = 0;
+
+	if (!btif || !buf || !len)
+		return -EINVAL;
+	if (len > MT8163_BTIF_MAX_FRAME)
+		return -EMSGSIZE;
+
+	tx = &btif->tx;
+	mutex_lock(&btif->tx_lock);
+
+	left = readl(tx->base + DMA_VFF_LEFT) & DMA_PTR_MASK;
+	if (len > left) {
+		ret = -EAGAIN;
+		goto out;
+	}
+
+	wpt = readl(tx->base + DMA_VFF_WPT);
+	offset = wpt & DMA_PTR_MASK;
+	wrap = wpt & DMA_PTR_WRAP;
+	first = min_t(size_t, len, DMA_VFIFO_SIZE - offset);
+	memcpy(tx->fifo + offset, buf, first);
+	if (first != len)
+		memcpy(tx->fifo, buf + first, len - first);
+
+	/* Publish the payload before handing its updated WPT to APDMA. */
+	dma_wmb();
+	offset += len;
+	if (offset >= DMA_VFIFO_SIZE) {
+		offset -= DMA_VFIFO_SIZE;
+		wrap ^= DMA_PTR_WRAP;
+	}
+
+	/* A completed flush clears DMA_EN; make the engine live before WPT. */
+	writel(DMA_ENABLE, tx->base + DMA_EN);
+	writel(offset | wrap, tx->base + DMA_VFF_WPT);
+
+	valid = readl(tx->base + DMA_VFF_VALID) & DMA_PTR_MASK;
+	if (valid && valid < BTIF_TX_FIFO_THRESHOLD)
+		writel(DMA_ENABLE, tx->base + DMA_FLUSH);
+
+	ret = len;
+out:
+	mutex_unlock(&btif->tx_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt8163_btif_write);
 
