+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_MT8163_BTIF_H
+#define _LINUX_MT8163_BTIF_H
+
+#include <linux/types.h>
+
+struct device;
+struct mt8163_btif;
+
+/* STP frames are at most 2014 bytes on the vendor implementation. */
+#define MT8163_BTIF_MAX_FRAME	2048
+
+/**
+ * struct mt8163_btif_client - in-kernel STP/WMT endpoint
+ * @receive: Called in hard IRQ context with one or two FIFO segments.
+ * @data: Opaque client data passed to @receive.
+ *
+ * The callback must copy or queue data before it returns and may not sleep.
+ */
+struct mt8163_btif_client {
+	void (*receive)(void *data, const u8 *buf, size_t len);
+	void *data;
+};
+
+struct mt8163_btif *mt8163_btif_get(struct device *dev);
+int mt8163_btif_register_client(struct mt8163_btif *btif,
+				const struct mt8163_btif_client *client);
+void mt8163_btif_unregister_client(struct mt8163_btif *btif,
+				   const struct mt8163_btif_client *client);
+int mt8163_btif_write(struct mt8163_btif *btif, const u8 *buf, size_t len);
+
+#endif /* _LINUX_MT8163_BTIF_H */
