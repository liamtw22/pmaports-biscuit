 /*
  * Biscuit routes the codec MCLK through GPIO119's CMMCLK function.
  * Amazon's machine driver uses a fixed 9.6 MHz source for this codec.
  */
+
+#define MT8163_MCLK_SENINF1_CTRL      0x100
+#define MT8163_MCLK_SENINF1_MUX_CTRL  0x120
+#define MT8163_MCLK_TOP_CTRL          0x000
+#define MT8163_MCLK_TG1_PH_CNT        0x200
+#define MT8163_MCLK_TG1_SEN_CK        0x204
+
+static void mt8163_biscuit_mclk_rmw(struct mt8163_biscuit_priv *priv,
+                                    u32 offset, u32 mask, u32 value)
+{
+    u32 reg = readl(priv->mclk_base + offset);
+
+    reg &= ~mask;
+    reg |= value & mask;
+    writel(reg, priv->mclk_base + offset);
+}
+
+static int mt8163_biscuit_enable_mclk(struct mt8163_biscuit_priv *priv)
+{
+    int ret;
+
+    if (priv->mclk_enabled)
+        return 0;
+
+    ret = pm_runtime_resume_and_get(priv->dev);
+    if (ret < 0)
+        return ret;
+
+    ret = clk_prepare_enable(priv->img_sen_tg);
+    if (ret)
+        goto err_put_pm;
+
+    ret = clk_prepare_enable(priv->camtg_sel);
+    if (ret)
+        goto err_disable_img;
+
+    ret = clk_set_parent(priv->camtg_sel, priv->univ_48m);
+    if (ret)
+        goto err_disable_camtg;
+
+    /*
+     * Vendor Biscuit setup: use the 48 MHz camera timing source and
+     * divide it by five to make the TLV320's required 9.6 MHz CMMCLK.
+     */
+    mt8163_biscuit_mclk_rmw(priv, MT8163_MCLK_TG1_SEN_CK,
+                            0x20000000, 0x20000000);
+    mt8163_biscuit_mclk_rmw(priv, MT8163_MCLK_TG1_PH_CNT,
+                            0x80000000, 0x80000000);
+    mt8163_biscuit_mclk_rmw(priv, MT8163_MCLK_TOP_CTRL, 0x00000c00,
+                            0x00000c00);
+    mt8163_biscuit_mclk_rmw(priv, MT8163_MCLK_TG1_SEN_CK,
+                            0x003f003f, 0x00040002);
+    mt8163_biscuit_mclk_rmw(priv, MT8163_MCLK_TG1_PH_CNT,
+                            0x10000047, 0x00000005);
+    mt8163_biscuit_mclk_rmw(priv, MT8163_MCLK_SENINF1_MUX_CTRL,
+                            0x80000000, 0x80000000);
+    mt8163_biscuit_mclk_rmw(priv, MT8163_MCLK_SENINF1_CTRL,
+                            0x00000001, 0x00000001);
+
+    priv->mclk_enabled = true;
+    return 0;
+
+err_disable_camtg:
+    clk_disable_unprepare(priv->camtg_sel);
+err_disable_img:
+    clk_disable_unprepare(priv->img_sen_tg);
+err_put_pm:
+    pm_runtime_put(priv->dev);
+    return ret;
+}
