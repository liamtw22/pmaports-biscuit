 static const u32 consys_known_ids[] = { 0x8163, 0x0321, 0x0335, 0x0337 };
 
+/*
+ * The processor cannot reach system memory on its own. This register in
+ * infracfg windows a slice of DRAM into its address space, and it is written
+ * in megabytes as an offset from the start of DRAM, which is why the reserved
+ * region has to be megabyte aligned: a region that is not would leave the
+ * processor pointed somewhere other than where the memory actually is.
+ */
+#define INFRACFG_CONSYS_EMI_MAPPING	0x320
+#define CONSYS_EMI_MAPPING_ENABLE	BIT(12)
+#define MT8163_DRAM_BASE		0x40000000UL
+
 /* The block needs a moment after the domain comes up before it will answer. */
 #define CONSYS_SETTLE_US		10
 #define CONSYS_ID_RETRIES		20
