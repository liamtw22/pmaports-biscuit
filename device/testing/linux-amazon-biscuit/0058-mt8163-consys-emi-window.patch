 	return false;
+}
+
+/*
+ * Point the processor at the slice of DRAM it has been given. Nothing here is
+ * needed to identify the block, but firmware download has nowhere to land
+ * without it, so a missing region is reported rather than treated as fatal.
+ */
+static int mt8163_consys_map_emi(struct mt8163_consys *priv)
+{
+	struct device *dev = priv->dev;
+	struct reserved_mem *rmem;
+	struct device_node *np;
+	u32 val, cur;
+	int ret;
+
+	np = of_parse_phandle(dev->of_node, "memory-region", 0);
+	if (!np) {
+		dev_info(dev, "no memory-region, firmware download will not be possible\n");
+		return 0;
+	}
+
+	rmem = of_reserved_mem_lookup(np);
+	of_node_put(np);
+	if (!rmem) {
+		dev_err(dev, "memory-region does not name a reserved region\n");
+		return -EINVAL;
+	}
+
+	if (!IS_ALIGNED(rmem->base, SZ_1M) || rmem->size < SZ_1M) {
+		dev_err(dev, "reserved region %pa size %pa must be at least 1 MiB and 1 MiB aligned\n",
+			&rmem->base, &rmem->size);
+		return -EINVAL;
+	}
+
+	if (rmem->base < MT8163_DRAM_BASE) {
+		dev_err(dev, "reserved region %pa is below the start of DRAM\n",
+			&rmem->base);
+		return -EINVAL;
+	}
+
+	val = ((rmem->base - MT8163_DRAM_BASE) >> 20) | CONSYS_EMI_MAPPING_ENABLE;
+
+	ret = regmap_read(priv->infracfg, INFRACFG_CONSYS_EMI_MAPPING, &cur);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read the EMI mapping register\n");
+
+	/* The vendor sets bits here rather than replacing the register. */
+	ret = regmap_write(priv->infracfg, INFRACFG_CONSYS_EMI_MAPPING, cur | val);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to write the EMI mapping register\n");
+
+	priv->emi_base = rmem->base;
+	priv->emi_size = rmem->size;
+	priv->emi_mapping = cur | val;
+
+	dev_info(dev, "EMI window %pa size %pa, mapping register 0x%08x\n",
+		 &priv->emi_base, &priv->emi_size, priv->emi_mapping);
+
+	return 0;
 }
 
