--- a/arch/arm64/boot/dts/mediatek/mt8163-amazon-biscuit.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8163-amazon-biscuit.dts
@@ -131,6 +131,35 @@
 };
 
 /*
+ * The thermal controller has no ADC of its own: it drives the AUXADC over the
+ * AHB bus. The AUXADC only converts once MT6577_AUXADC_PDN_EN (MISC 0x94, bit
+ * 14) is set, and the only code that sets it is mt6577_auxadc's probe.
+ * mt8163.dtsi leaves this node disabled, so that driver never probed and the
+ * converter stayed powered down.
+ *
+ * That did not look like a failure of the AUXADC. r191 enabled the sensor and
+ * all three zones registered, but every read returned -ENODATA. The controller
+ * was in fact running: it had written TS_CON1 = 0x1 via TEMPPNPMUXADDR and set
+ * channel 11 in AUXADC_CON1 via TEMPADCENADDR, so both of its AHB write paths
+ * worked, and every address it had been programmed with matched the vendor
+ * driver exactly. Only AUXADC_DAT11 stayed 0. The driver masks that to raw = 0,
+ * which with MT8163_CALIBRATION converts to roughly +443C - far outside
+ * MT8173_TEMP_MIN..MT8173_TEMP_MAX - so mtk_thermal_temp_is_valid() substitutes
+ * THERMAL_TEMP_INVALID and the thermal core turns that into -ENODATA.
+ *
+ * Confirmed on the running device by setting that one bit by hand: AUXADC_DAT11
+ * went from 0 to 0xdda, TEMP_MSR0..2 went to raw 3540-3555, and the zones read
+ * 33.7C, 33.6C and 33.6C.
+ *
+ * Enabled here rather than in mt8163.dtsi to keep the change board-scoped, but
+ * the coupling is really a SoC one: any mt8163 board that enables &thermal
+ * needs this too. Upstream mt8173.dtsi simply leaves its auxadc enabled.
+ */
+&auxadc {
+	status = "okay";
+};
