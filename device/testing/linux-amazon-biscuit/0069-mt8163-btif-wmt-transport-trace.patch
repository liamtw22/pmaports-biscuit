+void mt8163_btif_dump_state(struct mt8163_btif *btif, const char *tag)
+{
+	if (!btif || !READ_ONCE(btif->active))
+		return;
+
+	dev_warn(btif->dev,
+		 "BTIF trace %s: core dma_en=%#x handshake=%#x; tx en=%#x int=%#x flag=%#x valid=%u left=%u wpt=%#x rpt=%#x; rx en=%#x int=%#x flag=%#x valid=%u left=%u wpt=%#x rpt=%#x\n",
+		 tag, readl(btif->base + BTIF_DMA_EN),
+		 readl(btif->base + BTIF_HANDSHAKE),
+		 readl(btif->tx.base + DMA_EN), readl(btif->tx.base + DMA_INT_EN),
+		 readl(btif->tx.base + DMA_INT_FLAG),
+		 readl(btif->tx.base + DMA_VFF_VALID) & DMA_PTR_MASK,
+		 readl(btif->tx.base + DMA_VFF_LEFT) & DMA_PTR_MASK,
+		 readl(btif->tx.base + DMA_VFF_WPT),
+		 readl(btif->tx.base + DMA_VFF_RPT),
+		 readl(btif->rx.base + DMA_EN), readl(btif->rx.base + DMA_INT_EN),
+		 readl(btif->rx.base + DMA_INT_FLAG),
+		 readl(btif->rx.base + DMA_VFF_VALID) & DMA_PTR_MASK,
+		 readl(btif->rx.base + DMA_VFF_LEFT) & DMA_PTR_MASK,
+		 readl(btif->rx.base + DMA_VFF_WPT),
+		 readl(btif->rx.base + DMA_VFF_RPT));
+}
+EXPORT_SYMBOL_GPL(mt8163_btif_dump_state);
+
 int mt8163_btif_write(struct mt8163_btif *btif, const u8 *buf, size_t len)
 {
 	struct mt8163_btif_dma *tx;
@@ -182,6 +209,8 @@ int mt8163_btif_write(struct mt8163_btif *btif, const u8 *buf, size_t len)
 	valid = readl(tx->base + DMA_VFF_VALID) & DMA_PTR_MASK;
 	if (valid && valid < BTIF_TX_FIFO_THRESHOLD)
 		writel(DMA_ENABLE, tx->base + DMA_FLUSH);
+	if (!btif->trace_tx++)
+		mt8163_btif_dump_state(btif, "first-tx-queued");
 
 	/*
 	 * This API reports only success (0) or a negative errno.  In particular,
@@ -248,6 +277,10 @@ static void mt8163_btif_rx_consume(struct mt8163_btif_dma *rx)
 		valid = readl(rx->base + DMA_VFF_VALID);
 		rpt = readl(rx->base + DMA_VFF_RPT);
 		wpt = readl(rx->base + DMA_VFF_WPT);
+		if (loops == 1 && btif->trace_rx++ < 4)
+			dev_warn(btif->dev,
+				 "BTIF RX drain: valid=%#x wpt=%#x rpt=%#x\n",
+				 valid, wpt, rpt);
 		if (!valid && rpt == wpt)
 			break;
 
@@ -295,6 +328,10 @@ static irqreturn_t mt8163_btif_dma_irq(int irq, void *data)
 	if (!status)
 		return IRQ_NONE;
 
+	if (dma->btif->trace_irq++ < 4)
+		dev_warn(dma->btif->dev, "BTIF %s DMA IRQ %d: status=%#x\n",
+			 dma->name, irq, status);
+
 	/* MT8163 APDMA DMA_INT_FLAG is write-one-to-clear. */
 	writel(status, dma->base + DMA_INT_FLAG);
 
