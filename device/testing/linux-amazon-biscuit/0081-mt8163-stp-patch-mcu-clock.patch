 			goto out;
+		}
+		if (last)
+			dev_warn(stp->dev,
+				 "WMT patch %s final fragment acknowledged\n", name);
 		data += len;
 		remaining -= len;
 		fragment++;
@@ -817,6 +858,24 @@ static int mt8163_stp_bootstrap(struct mt8163_stp *stp)
 	if (ret)
