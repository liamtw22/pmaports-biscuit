+	0x0c, 0x01, 0x00, 0x80, 0x00, 0x4d, 0x84, 0x00,
+	0xff, 0xff, 0xff, 0xff,
+};
+static const u8 wmt_set_mcu_clk_disable_cmd[] = {
+	0x01, 0x08, 0x10, 0x00, 0x01, 0x01, 0x00, 0x01,
+	0x34, 0x03, 0x00, 0x80, 0x00, 0x00, 0x00, 0x00,
