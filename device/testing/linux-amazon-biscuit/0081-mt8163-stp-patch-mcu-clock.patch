+	unsigned int fragment = 0, fragments;
 	int ret;
 
 	ret = request_firmware_direct(&fw, name, stp->dev);
@@ -716,19 +738,38 @@ static int mt8163_stp_download_patch(struct mt8163_stp *stp,
 
 	data = fw->data + MT8163_WMT_PATCH_HEADER_LEN;
 	remaining = fw->size - MT8163_WMT_PATCH_HEADER_LEN;
+	fragments = DIV_ROUND_UP(remaining, MT8163_WMT_PATCH_FRAGMENT);
+	dev_info(stp->dev, "WMT patch %s body=%zu fragments=%u\n",
+		 name, remaining, fragments);
 	while (remaining) {
+		bool last;
+
 		len = min_t(size_t, remaining, MT8163_WMT_PATCH_FRAGMENT);
+		last = remaining == len;
 		cmd[0] = 0x01;
 		cmd[1] = 0x01;
 		cmd[2] = (len + 1) & 0xff;
 		cmd[3] = (len + 1) >> 8;
