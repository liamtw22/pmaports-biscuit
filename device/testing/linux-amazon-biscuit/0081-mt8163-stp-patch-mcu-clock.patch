+		cmd[4] = last ? 0x03 : fragment ? 0x02 : 0x01;
 		memcpy(cmd + 5, data, len);
+		if (last)
+			dev_warn(stp->dev,
+				 "WMT patch %s final fragment %u/%u data=%zu wmt=%zu stp=%zu flag=%#x\n",
+				 name, fragment + 1, fragments, len, len + 5,
+				 len + 11, cmd[4]);
 
 		ret = mt8163_stp_wmt_xfer(stp, cmd, len + 5,
