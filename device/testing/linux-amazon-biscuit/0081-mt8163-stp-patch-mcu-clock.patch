+		 "WMT patch-download MCU clock selected at 138.67 MHz\n");
+
 	for (i = 0; i < ARRAY_SIZE(patches); i++) {
 		ret = mt8163_stp_download_patch(stp, patches[i].name,
 						patches[i].address);
@@ -829,6 +888,23 @@ static int mt8163_stp_bootstrap(struct mt8163_stp *stp)
 			return dev_err_probe(stp->dev, ret, "WMT patch reset failed\n");
 	}
 
+	/* Stock restores 26 MHz and closes the clock-programming window. */
+	ret = mt8163_stp_wmt_xfer(stp, wmt_set_mcu_clk_26_cmd,
+				  sizeof(wmt_set_mcu_clk_26_cmd),
+				  wmt_set_mcu_clk_evt,
+				  sizeof(wmt_set_mcu_clk_evt));
+	if (ret)
+		return dev_err_probe(stp->dev, ret,
+				     "WMT patch MCU-clock 26-MHz restore failed\n");
+	ret = mt8163_stp_wmt_xfer(stp, wmt_set_mcu_clk_disable_cmd,
+				  sizeof(wmt_set_mcu_clk_disable_cmd),
+				  wmt_set_mcu_clk_evt,
+				  sizeof(wmt_set_mcu_clk_evt));
+	if (ret)
+		return dev_err_probe(stp->dev, ret,
+				     "WMT patch MCU-clock programming disable failed\n");
+	dev_warn(stp->dev, "WMT patch-download MCU clock restored to 26 MHz\n");
+
 	ret = mt8163_consys_bt_paldo_set(stp->consys_dev, true);
 	if (ret)
 		return dev_err_probe(stp->dev, ret, "failed to enable BT PALDO\n");
