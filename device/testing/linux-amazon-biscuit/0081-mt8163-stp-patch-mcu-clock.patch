+				  wmt_set_mcu_clk_evt,
+				  sizeof(wmt_set_mcu_clk_evt));
+	if (ret)
+		return dev_err_probe(stp->dev, ret,
+				     "WMT patch MCU-clock programming enable failed\n");
+	ret = mt8163_stp_wmt_xfer(stp, wmt_set_mcu_clk_138_cmd,
+				  sizeof(wmt_set_mcu_clk_138_cmd),
+				  wmt_set_mcu_clk_evt,
+				  sizeof(wmt_set_mcu_clk_evt));
+	if (ret)
