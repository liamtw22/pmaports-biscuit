pkgdesc="Amazon Echo Dot (2nd gen)"
pkgver=6
pkgrel=295
# The public release this build is: the name on the release page, the install
# zip and the settings page. pkgrel is the build and keeps counting, because
# apk orders upgrades by it and a release name like 1.0 would sort below the
# 6-r2xx builds already installed. Each public build gets a new name - v1.0.1
# for fixes, v1.1 for features - and the installer refuses a name already
# given to another build (installer/zip/releases.json).
_release="v1.0"
url="https://github.com/liamtw22/pmaports-biscuit"
# Core is our own code (MIT) plus two vendored pieces that keep their own
# licences: TweetNaCl-js (public domain, Unlicense) for the setup and settings
# pages, and aioesphomeapi's two generated protobuf modules (MIT) for the
# Bluetooth proxy. The -voice and -sendspin bundles set their own license=
# below. See NOTICE and PROVENANCE.md at the repository root.
license="MIT AND Unlicense"
arch="aarch64"
options="!check !archcheck !tracedeps"
# alsa-utils supplies amixer, aplay, alsaucm and arecord. biscuit-audio.py
# drives the mixer through amixer, so without it the audio service crashes at
# start and there is no way to play anything.
#
# It was missing from this list for a long time and nobody noticed, because the
# rootfs build chroot had it installed by hand from an earlier debugging
# session and every image inherited it by accident. Rebuilding that chroot from
# scratch is what exposed it - worth doing periodically, since an image is only
# as reproducible as its declared depends.
#
# py3-jeepney (105 KiB, pure Python) is the D-Bus client the ACTIVE half of the
# proxy uses to drive BlueZ GATT - connect, read, write, subscribe. Only the
# active half needs it, and that is off by default, but it is a dependency
# rather than an optional import because a proxy that cannot connect when the
# switch is flipped is worse than 105 KiB.
#
# py3-protobuf (1.3 MB) is the ONLY dependency biscuit-btproxy needs to speak
# the ESPHome API to Home Assistant. Advertisements come off the HCI monitor
# socket using nothing but the standard library, and the two generated _pb2
# modules are vendored in btproxy/ rather than pulling in aioesphomeapi, which
# would drag in noiseprotocol, cryptography and an async client the proxy does
# not use. That is what keeps the proxy in this package instead of behind the
# ~100 MB voice bundle - it is useful on a device that never runs the assistant.
#
# util-linux-misc supplies chrt, which biscuit-dsp.initd and
# biscuit-mic-stream.sh use to put the playback and capture paths on
# SCHED_FIFO. Measured: without it the beamformer sits on the run queue
# 19.5% of the time under load and arecord drops periods, while the DSP at
# FIFO 50 is untouched. It reaches every image today only because
# postmarketos-initramfs happens to require it - a transitive guarantee
# through a package that has nothing to do with audio. If that ever changes
# the audio path silently degrades rather than failing, which is precisely
# how alsa-utils went unnoticed above.
#
# NOTE: everything between the quotes below is a shell string, so a "#" line in
# there is not a comment - it becomes a dependency literally named "#" and the
# build fails with "dependency not found: #". Comments go here instead.
# NOTE: no comments inside depends= - abuild takes a '#' line as a literal
# package name and the build dies with "dependency not found: #".
#
# pipewire-alsa: provides libasound_module_pcm_pipewire.so, which is what makes
# the ALSA device `default` resolve to PipeWire. WITHOUT IT THE DEVICE HAS NO
# WORKING AUDIO OUTPUT AT ALL - every earcon fails with "cannot open audio
# device default (No such device or address)" - and it fails SILENTLY, because
# sndfile-play exits 0 regardless. It was only ever installed by hand as part
# of the voice-bundle recipe, so every core-only device shipped mute.
#
# wireless-regdb: without /lib/firmware/regulatory.db the kernel falls back to
# its built-in world domain, which marks every 5 GHz rule PASSIVE-SCAN and
# ignores `iw reg set` entirely - the region a user picks during setup would do
# nothing at all. See 51-biscuit-regdb.files for why the package alone is not
# enough and the database has to reach the initramfs.
#
# py3-pynacl: the setup portal boxes the Wi-Fi passphrase and the new account
# password in the browser before they cross the open setup AP. PyNaCl is the
# server half; TweetNaCl (vendored, nacl-fast.min.js) is the browser half. Two
# audited implementations of one primitive, rather than anything hand-rolled.
#
# openssh-keygen: biscuit-persist calls `ssh-keygen -A` to create the host
# identity before sshd would, so the very first boot's keys are the ones
# that reach the persistent store. Declared rather than inherited - the
# -voice subpackage relied on exactly this kind of ambient dependency for
# nine revisions and crash-looped on a clean install.
#
# cmd:sudo, NOT sudo: we ship /etc/sudoers.d/10-biscuit-wheel, which is the
# whole of remote administration on this device, and an inert sudoers file is
# invisible - there is no error, sudo simply is not there. But this image
# installs sudo-rs, not sudo, and both own /usr/bin/sudo; depending on the
# real package would drag in a conflicting second implementation. The virtual
# cmd:sudo is satisfied by whichever one is present.
#
# pipewire-tools: pw-record, which biscuit-btcast.sh pipes into aplay. Without
# it the Bluetooth cast bridge cannot start at all, and says only "bridge did
# not start" because both halves of that pipeline discard stderr. It was never
# declared, so casting worked only on a device where it had been installed by
# hand and was silently broken on every clean image.
depends="
	cmd:sudo
	linux-amazon-biscuit
	mtk-mkimage
	mkbootimg
	postmarketos-base
	alsa-ucm-conf
	alsa-utils
	util-linux-misc
