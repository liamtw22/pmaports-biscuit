builddir="$srcdir"

subpackages="
	$pkgname-voice:voice
	$pkgname-sendspin:sendspin
	$pkgname-pulseaudio:pulseaudio
	$pkgname-nonfree-firmware:nonfree_firmware
"

build() {
	devicepkg_build $startdir $pkgname
	# Real-time beamformer. Built here rather than shipped as a binary so it
	# is reproducible from source and matches the target's libc.
	${CC:-gcc} $CFLAGS $LDFLAGS -O2 -pthread -o biscuit-beamform \
		"$srcdir"/biscuit-beamform.c -lm

	# Bluetooth call audio. C rather than a script because CVSD is a per-bit
	# codec at 64 kbit/s in BOTH directions - 128000 bit iterations per second
	# of wall clock, continuously, on this SoC. A Python loop would not hold
	# real time and the call would break up.
	# -lsbc: mSBC decoding. libsbc is already on the device because
	# bluez-alsa links it, but declare it anyway - an undeclared build
	# dependency that happens to be present in the chroot has bitten this
	# package three times, and each time it shipped an image broken in a
	# way the build itself could not see.
	${CC:-gcc} $CFLAGS $LDFLAGS -O2 -I"$srcdir" -o biscuit-btcall \
		"$srcdir"/biscuit-btcall.c -lasound -lsbc -lm

	# The call path's echo canceller. The RUNNING r164 package installs this
	# binary and this tree had neither the binary nor its source, so a build
	# from here produced a device with no call DSP at all.
	#
	# PROVENANCE ESTABLISHED. A prebuilt binary in live-echo-reference-20260911
	# is byte-identical to the deployed /usr/bin/biscuit-call-dsp
	# (sha256 7c4774be...), and that directory's build.json records the same
	# hash - so these three files, not the rejected-polynomial-experiment copy
	# beside them, are what shipped. The two variants have identical string AND
	# function sets, so only the hash separates them.
	#
	# It needs biscuit-echo-reference.c for er_reader_open/process/close and
	# -I"$srcdir" for its header; without either it compiles and then fails to
	# link, which is how the missing pieces were found.
	#
	# VERIFIED in the real aarch64-musl chroot (pmbootstrap buildroot, Alpine
	# gcc 15.2.0). This line builds cleanly and the result produces
	# BYTE-IDENTICAL output to the deployed binary over 30 s of real 8-channel
	# capture - 960,000 bytes, cmp clean.
	#
	# VERIFIED AGAIN from the PACKAGE, which is the artefact that actually
	# ships: the binary extracted from device-amazon-biscuit-6-r151.apk (67312
	# bytes, stripped by abuild, against 75336 unstripped) was run on the device
	# beside the deployed one over 3750 frames. Output sha256 1cde8535... from
	# both. Every deterministic stderr counter matches too; the sole difference
	# is echo-reference max_us (52 vs 39), which is wall-clock timing. Checking
	# the chroot object alone would not have covered abuild's strip.
	#
	# The ELFs are NOT identical (75336 vs 74280 bytes) and cannot be: the
	# shipped binary was never built by this package. It came from an ad-hoc
	# script using aarch64-linux-gnu-gcc with -O3 -mcpu=cortex-a53 -nostdinc
	# -nostdlib -no-pie and hand-passed crt objects. Identical DSP output across
	# that toolchain gap is the stronger result, and it holds because this path
	# takes no -ffast-math, so IEEE semantics survive -O2 vs -O3.
	${CC:-gcc} $CFLAGS $LDFLAGS -O2 -I"$srcdir" -o biscuit-call-dsp \
		"$srcdir"/biscuit-call-dsp.c "$srcdir"/biscuit-echo-reference.c \
		-lspeexdsp -lm

	# Fire OS 6 derived assistant DSP, the second selectable microphone profile.
	# Built here for the same reason the beamformer is: reproducible from source
	# and matched to the target libc, rather than a binary dropped in by hand.
	#
	# Its AEC step-size schedule is OUR curve, compiled in as the default. The
	# Fire OS 6 one is not redistributable and is loaded at run time from
	# aec_vss_table.bin in the assets directory when the owner imports it.
	#
	# vad/dnn_vad.c dlopen()s the TensorFlow Lite runtime already shipped for
	# microWakeWord, so it needs -ldl and the result MUST stay dynamically
	# linked: a statically linked musl binary cannot dlopen at all, and the
	# VAD would silently fall back to the energy prototype on every boot.
	# Stock vad_lite.tflite is owner-imported and is never packaged.
	${CC:-gcc} $CFLAGS $LDFLAGS -O2 -std=c11 -pthread -o biscuit-mic-fireos6 \
		"$srcdir"/biscuit-fireos6/src/frontend.c \
		"$srcdir"/biscuit-fireos6/src/aec.c \
		"$srcdir"/biscuit-fireos6/adaptive/adaptive.c \
		"$srcdir"/biscuit-fireos6/controls/stock_policy.c \
		"$srcdir"/biscuit-fireos6/controls/group_policy.c \
		"$srcdir"/biscuit-fireos6/controls/ara_metrics.c \
		"$srcdir"/biscuit-fireos6/reference/bounded_reference.c \
		"$srcdir"/biscuit-fireos6/reference/legacy_bridge.c \
		"$srcdir"/biscuit-fireos6/vad/dnn_vad.c \
		-ldl -lm

	# A statically linked build would still succeed here and then fail in a way
	# nothing reports: musl static binaries cannot dlopen at all, so the DNN VAD
	# would fall back to the energy prototype on every boot, silently, costing
	# detections with no error anywhere. Assert the interpreter is present.
	#
	# Read it from the ELF program header with scanelf (pax-utils, which abuild
	# itself depends on). The old test, `grep -q ld-musl` over the binary, was a
	# coin toss: busybox grep sees the file as "lines" split at 0x0a bytes, and
	# the interpreter string sits right behind the GNU build-id note, whose bytes
	# are a hash. r265 passed; r266 failed with a correctly dynamic binary
	# (scanelf: /lib/ld-musl-aarch64.so.1), and grep -c on the host found it.
	case "$(scanelf -qi biscuit-mic-fireos6)" in
	/lib/ld-musl-*) ;;
	*)
		error "biscuit-mic-fireos6 is statically linked; dnn_vad dlopen() cannot work"
		return 1
		;;
	esac

	# Playback DSP: speaker correction, per-volume loudness, compressor and
	# limiter. -ffast-math is wanted here - a fixed-size float pipeline with
	# no NaN or denormal paths, and the 1024-tap FIR is the hot loop.
	#
	# It also WRITES the echo reference that biscuit-call-dsp reads, through
	# struct er_writer in biscuit-echo-reference.h - so it needs that
	# translation unit and -I"$srcdir", exactly as the call DSP does.
	#
	# This tree's biscuit-dsp.c carried NEITHER: it was an older revision with
	# no echo-reference code at all, so a package built from it produced a
	# playback DSP that never published a reference and a canceller with
	# nothing to cancel against. Found by diffing the strings of the built
	# binary against the deployed one - /run/biscuit-dsp/echo-reference and the
	# two echo-reference log formats were present on the device and absent from
	# the build.
	#
	# PROVENANCE, settled the same way biscuit-call-dsp's was: the prebuilt
	# biscuit-dsp in live-echo-reference-20260911 is byte-identical to the
	# deployed /usr/bin/biscuit-dsp (sha256 cd1905b0..., 76528 bytes) and that
	# directory's build.json records the same hash, so its biscuit-dsp.c is what
	# shipped. That is the file now here.
	${CC:-gcc} $CFLAGS $LDFLAGS -O2 -ffast-math -I"$srcdir" -o biscuit-dsp \
		"$srcdir"/biscuit-dsp.c "$srcdir"/biscuit-echo-reference.c \
		-lasound -lm
}

# pre-upgrade keeps the speaker correction curve of a device upgrading from
# r293 or older: that release shipped it, this one does not (it is Amazon's
# EQ_50.cfg, now owner-imported), and only a PRE-upgrade script still sees
# the old file. See device-amazon-biscuit.pre-upgrade.
install="$pkgname.post-install $pkgname.post-upgrade $pkgname.pre-upgrade"

package() {
	devicepkg_package $startdir $pkgname
    install -Dm755 "$srcdir"/mdev-persistent-storage "$pkgdir"/usr/lib/mdev/persistent-storage
    install -Dm644 "$srcdir"/50-device-amazon-biscuit-mdev.files "$pkgdir"/usr/share/mkinitfs/files/50-device-amazon-biscuit-mdev.files
    install -Dm644 "$srcdir"/51-biscuit-regdb.files "$pkgdir"/usr/share/mkinitfs/files/51-biscuit-regdb.files
	install -Dm755 "$srcdir"/05-boot-rw.hook "$pkgdir"/etc/boot-deploy/hooks/05-boot-rw.hook
	install -Dm755 "$srcdir"/dtb-mtk-wrap.hook "$pkgdir"/etc/boot-deploy/hooks/10-dtb-mtk-wrap.hook
	# LED and button services. Without these a flashed device has a dark ring
	# and dead volume/mute keys, which is what happened after every flash until
	# now. led.start/led.stop are deliberately gone: they drove
	# /sys/bus/i2c/devices/0-003f/{boot_animation,frame}, which this kernel does
	# not expose, so they were exit-0 no-ops. biscuit-ring owns the ring now,
	# and two writers would fight over the same LEDs.
	local _svc
	for _svc in biscuit-als biscuit-ring biscuit-audio biscuit-btring; do
		install -Dm755 "$srcdir/$_svc.py" "$pkgdir/usr/bin/$_svc.py"
		install -Dm755 "$srcdir/$_svc.initd" "$pkgdir/etc/init.d/$_svc"
		# biscuit-ring goes in BOOT, not default. In default it was one of 55
		# services starting at t+10s and was not up until t+21s, while boot
		# finishes around t+34s - so the "while booting" animation had no
		# window at all. From the boot runlevel it is up at t+7s. Measured.
		local _rl=default
		[ "$_svc" = biscuit-ring ] && _rl=boot
		install -d "$pkgdir/etc/runlevels/$_rl"
		ln -sf "/etc/init.d/$_svc" "$pkgdir/etc/runlevels/$_rl/$_svc"
	done

	# The layer and priority tables ONLY - no artwork. Stock's 283 animations are
	# Amazon assets that cannot be redistributed; the shipped defaults are
	# biscuit-ring-fx effects, rendered per activity into /opt/persist/led-fx.
	# This table is what orders one animation over another, and without it
	# everything lands on layer 0 - which is how a muted microphone once masked
	# every other animation on the ring. It used to be a tarball holding stock's
	# own layer_config_common.json plus an alias map into it; that file was
	# Amazon's, verbatim, so it is gone and this is ours. biscuit-ring.initd
	# checks the directory exists, so create it even though one file goes in it.
	# Expected content of the owner-imported stock audio assets: HASHES ONLY, no
	# vendor content. biscuit-mic-stream.sh checks these before it execs the chain
	# and the settings layer reads the same file, so the page cannot say a profile
	# is available when the thing that starts it would refuse.
	# The USB link's DHCP server config, as a template: usb-rndis substitutes the
	# interface it actually detected, because the kernel does not always give the
	# RNDIS function usb0. Committed months ago and never listed in source=, so it
	# was never installed and no udhcpd ever ran - see the note in usb-rndis.initd.
	install -Dm644 "$srcdir"/udhcpd-usb.conf \
		"$pkgdir"/usr/share/biscuit/udhcpd-usb.conf

	install -Dm644 "$srcdir"/biscuit-profile-assets.json \
		"$pkgdir"/usr/share/biscuit/biscuit-profile-assets.json
	# Ours, generated by tools/make_setup_chime.py: the setup page's device check
	# plays it when the owner's own earcons are not installed yet.
	install -Dm644 "$srcdir"/biscuit-setup-chime.wav \
		"$pkgdir"/usr/share/biscuit/biscuit-setup-chime.wav
	# The owner's own importer. The assets it installs are Amazon's and are
	# NOT shipped - only their hashes, in the manifest above. This runs ON
	# the device: the version it replaces ran on a developer's laptop and
	# copied in over SSH with a hard-coded key path and IP, which no owner
	# can use.
	install -Dm755 "$srcdir"/biscuit-import-assets \
		"$pkgdir"/usr/bin/biscuit-import-assets

	install -d "$pkgdir"/usr/share/biscuit-ring/led-resources
	install -Dm644 "$srcdir"/biscuit-ring-priorities.json \
		"$pkgdir"/usr/share/biscuit-ring/led-resources/biscuit-ring-priorities.json

	# Bring Wi-Fi up at boot. Not the networking + wpa_supplicant services:
	# busybox ifupdown does not wait for association before running the DHCP
	# client, so the lease request loses the race and the interface comes up
	# with no address. This waits for wpa_state=COMPLETED, and reloads the
	# driver and retries once if association fails - which is the only thing
	# that reliably clears a wedged supplicant. It is what keeps the device
	# reachable when it is not plugged into the development host.
	install -Dm755 "$srcdir"/wifi.start "$pkgdir"/etc/local.d/wifi.start

	# Bluetooth speaker support.
	#
	# Four things must all hold or A2DP silently fails, and each was a manual
	# repair after every flash before this: the adapter must advertise the
	# loudspeaker device class (set by the post-install, since only
	# /etc/bluetooth/main.conf carries it), a pairing agent must be registered
	# or the phone reports a bogus PIN error, the peer must be TRUSTED or BlueZ
	# times out authorising the A2DP service and drops the link, and
	# bluealsa-aplay must run or the decoded stream never reaches the speaker.
	install -Dm755 "$srcdir"/biscuit-btaudio.sh "$pkgdir"/usr/bin/biscuit-btaudio.sh

	# Casting this device's audio to a paired Bluetooth speaker. The bridge
	# taps biscuit_speaker.monitor, so nothing upstream needs reconfiguring.
	install -Dm755 "$srcdir"/biscuit-btcast.sh "$pkgdir"/usr/bin/biscuit-btcast.sh
	install -Dm755 "$srcdir"/biscuit-btcast.initd "$pkgdir"/etc/init.d/biscuit-btcast
	ln -sf /etc/init.d/biscuit-btcast "$pkgdir"/etc/runlevels/default/biscuit-btcast

	# Bluetooth LE proxy for Home Assistant. The service lives under /usr/lib
	# rather than /usr/bin because it is not a command anyone runs by hand: it
	# ships with two vendored protobuf modules that have to sit importable
	# beside it, and a package directory keeps them together.
	#
	# In the default runlevel unconditionally, and enabled-or-idle from
	# /opt/persist/btproxy.env. Keeping "enabled" in the config rather than in
	# a runlevel symlink means :8080 and Home Assistant toggle one thing, not
	# two that can disagree - the split that made biscuit-mic-pump confusing.
	install -Dm755 "$srcdir"/biscuit-btproxy.py 		"$pkgdir"/usr/lib/biscuit-btproxy/biscuit-btproxy.py
	# Installed under their import names: the service does
	# sys.path.insert(0, its own directory) and imports them as `bluez` and
	# `active`, so the source filenames carry the biscuit- prefix only to keep
	# the package directory navigable.
	install -Dm644 "$srcdir"/biscuit-btproxy-bluez.py 		"$pkgdir"/usr/lib/biscuit-btproxy/bluez.py
	install -Dm644 "$srcdir"/biscuit-btproxy-active.py 		"$pkgdir"/usr/lib/biscuit-btproxy/active.py
	install -Dm644 "$srcdir"/api_pb2.py 		"$pkgdir"/usr/lib/biscuit-btproxy/aioesphomeapi_min/api_pb2.py
	install -Dm644 "$srcdir"/api_options_pb2.py 		"$pkgdir"/usr/lib/biscuit-btproxy/aioesphomeapi_min/api_options_pb2.py
	install -Dm644 "$srcdir"/__init__.py 		"$pkgdir"/usr/lib/biscuit-btproxy/aioesphomeapi_min/__init__.py
	install -Dm755 "$srcdir"/biscuit-btproxy.initd "$pkgdir"/etc/init.d/biscuit-btproxy
	ln -sf /etc/init.d/biscuit-btproxy "$pkgdir"/etc/runlevels/default/biscuit-btproxy
	# Advertised over mDNS so Home Assistant offers it instead of needing an IP.
	install -Dm644 "$srcdir"/biscuit-btproxy.avahi.service 		"$pkgdir"/etc/avahi/services/biscuit-btproxy.service

	# Timekeeping. chrony is installed and enabled already, but away from a
	# network that permits NTP it has no source at all - it never syncs, so
	# rtcsync never writes the RTC and a power cut leaves the clock 43 years
	# out. This feeds it Home Assistant's HTTP Date header as a reference
	# clock, which keeps chrony the single authority.
	install -Dm755 "$srcdir"/biscuit-timesync.py "$pkgdir"/usr/bin/biscuit-timesync.py
	install -Dm755 "$srcdir"/biscuit-timesync.initd "$pkgdir"/etc/init.d/biscuit-timesync
	install -Dm644 "$srcdir"/50-biscuit-httpdate.conf "$pkgdir"/etc/chrony/conf.d/50-biscuit-httpdate.conf
	# Caps chronyd's slew at 500 ppm. Without it a correction can drag the
	# system clock fast enough to disturb the audio clock the capture and
	# playback graphs are disciplined against. Also missed at import.
	install -Dm644 "$srcdir"/90-biscuit-audio-slew.conf \
		"$pkgdir"/etc/chrony/conf.d/90-biscuit-audio-slew.conf
	ln -sf /etc/init.d/biscuit-timesync "$pkgdir"/etc/runlevels/default/biscuit-timesync
	install -Dm755 "$srcdir"/biscuit-btaudio.initd "$pkgdir"/etc/init.d/biscuit-btaudio
	ln -sf /etc/init.d/biscuit-btaudio "$pkgdir"/etc/runlevels/default/biscuit-btaudio

	# First-boot Wi-Fi setup: an open network, a captive portal, and the join.
	#
	# NOT symlinked into a runlevel, and that is deliberate - nothing should
	# broadcast an open network on every boot. wifi.start starts it on demand
	# when no network is configured or when the saved credentials stop working,
	# and the same "rc-service biscuit-setup restart" is what a button handler or
	# Home Assistant would call - restart, not start, because OpenRC keeps the
	# one-shot marked started after a session and refuses a second start.
	#
	# The AP runs on p2p0, registered through /proc/net/wlan/p2p_mode with mode
	# 0. Mode 1 registers ap0, which looks like the obvious choice for an access
	# point and fails silently: hostapd reaches AP-ENABLED with state=ENABLED
	# and freq=2437 while the device radiates nothing, because
	# p2pStateInit_IDLE fails its eIntendOPMode == OP_MODE_ACCESS_POINT test and
	# the AP never re-acquires the channel. Needs kernel r218 or later.
	# Playback DSP. Everything that plays audio opens pcm."default", which
	# asound.conf points at the snd-aloop loopback; biscuit-dsp drains that,
	# applies the chain, and writes the codec. One insertion point, so nothing
	# else had to change.
	#
	# UNLIKE biscuit-setup, THIS ONE IS IN THE DEFAULT RUNLEVEL, and must be:
	# with "default" pointing at the loopback there is no path to the codec
	# without it and playback is silent. supervise-daemon respawns it.
	#
	# The correction and the limiter are a package deal. The owner's imported
	# speaker curve (EQ_50.cfg, never shipped here) applies up
	# to +24 dB between 120 and 300 Hz, which needs the compressor behind it or
	# it risks the driver; biscuit_direct in asound.conf bypasses both together
	# and is the only supported bypass.
	install -Dm755 biscuit-dsp "$pkgdir"/usr/bin/biscuit-dsp
	install -Dm755 "$srcdir"/biscuit-dsp.initd "$pkgdir"/etc/init.d/biscuit-dsp
	install -d "$pkgdir"/etc/runlevels/default
	ln -sf /etc/init.d/biscuit-dsp "$pkgdir"/etc/runlevels/default/biscuit-dsp

	# The converters only accept coefficient memory while the ADC is fully
	# powered down, so a chip that is busy when the UCM fires silently keeps
	# no filter for the whole session - and amixer cannot tell, because it
	# reports the regmap cache rather than the chip. This checks the hardware
	# directly after boot and rewrites any converter that missed.
	install -Dm755 "$srcdir"/biscuit-mic-coeff.py "$pkgdir"/usr/bin/biscuit-mic-coeff.py
	install -Dm755 "$srcdir"/biscuit-mic-coeff.initd "$pkgdir"/etc/init.d/biscuit-mic-coeff
	ln -sf /etc/init.d/biscuit-mic-coeff "$pkgdir"/etc/runlevels/default/biscuit-mic-coeff

	# Wi-Fi credentials, Bluetooth pairings and the device name live on
	# partition 14, not the rootfs, so an update flash keeps them and a
	# factory reset can erase them. This MUST be a service rather than an
	# /etc/fstab entry: fstab is on the rootfs that a flash replaces, so
	# mounts written there survive a reboot and vanish on exactly the
	# occasion they exist for. That was tried, and it lost a user's network
	# on the first flash after setup.
	#
	# Retire the shipped default account (user / 147147) once setup has made
	# the owner's, and until then keep its published password off SSH except
	# over USB. Guarded by /opt/persist/provisioned, and in the BOOT runlevel:
	# it must finish before biscuit-setup offers to create the real account,
	# and before sshd could accept a login with the old one.
	install -Dm755 "$srcdir"/biscuit-firstboot.initd "$pkgdir"/etc/init.d/biscuit-firstboot
	install -d "$pkgdir"/etc/runlevels/boot
	ln -sf /etc/init.d/biscuit-firstboot "$pkgdir"/etc/runlevels/boot/biscuit-firstboot

	# boot runlevel, not default: it has to be up before wpa_supplicant and
	# bluetoothd read the state it provides.
	install -Dm755 "$srcdir"/biscuit-persist.initd "$pkgdir"/etc/init.d/biscuit-persist

	# Rebuilds the owner account after a flash. Called by biscuit-persist at
	# boot and by the :8080 password form, so it lives in /usr/bin rather than
	# being inlined in the init script.
	install -Dm755 "$srcdir"/biscuit-persist-account "$pkgdir"/usr/bin/biscuit-persist-account

	# Bluetooth call audio bridge and its service.
	install -Dm755 biscuit-btcall "$pkgdir"/usr/bin/biscuit-btcall
	install -Dm755 "$srcdir"/biscuit-btcall.initd "$pkgdir"/etc/init.d/biscuit-btcall
	install -d "$pkgdir"/etc/runlevels/default
	ln -sf /etc/init.d/biscuit-btcall "$pkgdir"/etc/runlevels/default/biscuit-btcall

	# Mode 0440 is not decoration: sudo ignores any file in sudoers.d that is
	# group- or world-writable, and does so without saying anything, so a wrong
	# mode here looks exactly like the rule not existing.
	install -Dm440 "$srcdir"/biscuit-wheel-nopasswd \
		"$pkgdir"/etc/sudoers.d/10-biscuit-wheel
	# SSH policy: no login at all from the open setup network, and no
	# password login for the shipped default account (user / 147147) except
	# over USB while that password is live. The runtime halves live in
	# /run/biscuit-sshd, written by biscuit-setup.sh and biscuit-firstboot.
	install -Dm644 "$srcdir"/biscuit-sshd.conf \
		"$pkgdir"/etc/ssh/sshd_config.d/40-biscuit.conf
	install -d "$pkgdir"/etc/runlevels/boot
	ln -sf /etc/init.d/biscuit-persist "$pkgdir"/etc/runlevels/boot/biscuit-persist
	# Grow the root filesystem to fill its partition. pmOS resizes the
	# PARTITION at first boot but the FILESYSTEM resize routinely does not
	# take on this device - after r231 a 929 MiB partition held a 558 MiB
	# filesystem. Without this the planned repartition (3371 MiB) would
	# appear to do nothing at all.
	install -Dm755 "$srcdir"/biscuit-growroot.initd "$pkgdir"/etc/init.d/biscuit-growroot
	ln -sf /etc/init.d/biscuit-growroot "$pkgdir"/etc/runlevels/boot/biscuit-growroot

	install -Dm755 "$srcdir"/biscuit-factory-reset.sh "$pkgdir"/usr/bin/biscuit-factory-reset
	install -Dm644 "$srcdir"/snd-aloop.conf "$pkgdir"/etc/modprobe.d/snd-aloop.conf

	# The speaker correction curve is NOT shipped: it is Amazon's EQ_50.cfg.
	# The owner imports it from their own backup (profile "speaker" in
	# biscuit-profile-assets.json) and biscuit-dsp reads it from
	# /opt/persist/biscuit/assets/speaker; /etc/biscuit/eq/speaker.fir, when
	# present, still wins over it. Without either the speaker plays flat.

	# Editable config. Under /etc because these are meant to be edited; the
	# user EQ ships empty and mbcl.conf ships the factory dynamics.
	install -Dm644 "$srcdir"/mbcl.conf "$pkgdir"/etc/biscuit/mbcl.conf
	install -Dm644 "$srcdir"/user-eq.conf "$pkgdir"/etc/biscuit/user-eq.conf
	# The EQ as the settings page and Home Assistant see it lives in
	# /opt/persist/eq.json; the two files above are only what the DSP reads.
	# biscuit-dsp.initd re-derives them from eq.json on every start, so a reset
	# or a reflash cannot leave the page and the DSP disagreeing. Core, because
	# biscuit-dsp is.
	install -Dm644 "$srcdir"/biscuit_eq.py "$pkgdir"/usr/bin/biscuit_eq.py

	install -Dm755 "$srcdir"/biscuit-setup.sh "$pkgdir"/usr/bin/biscuit-setup.sh

	# Earcons. The activity->sound table is CORE, not part of the assistant
	# bundle: boot, Wi-Fi, setup and Bluetooth all play sounds on a device
	# with no assistant installed, so biscuit-earcon must be able to resolve
	# one without importing biscuit-va-leds.
	install -Dm755 "$srcdir"/biscuit-earcon-map.py "$pkgdir"/usr/bin/biscuit-earcon-map.py
	install -Dm755 "$srcdir"/biscuit-earcon "$pkgdir"/usr/bin/biscuit-earcon
	install -Dm755 "$srcdir"/biscuit-earcon-args "$pkgdir"/usr/bin/biscuit-earcon-args
	# 50 ms of digital silence. The assistant takes each of its sounds as a
	# file path and falls back to its own bundled sound when the flag is left
	# out, so "Silent" has to be a real file it can play. Not in the earcon
	# directory, so it is never offered as a sound of its own.
	install -Dm644 "$srcdir"/biscuit-silence.wav "$pkgdir"/usr/share/biscuit/silence.wav
	# NO EARCONS ARE SHIPPED. Stock's are Amazon recordings that each owner
	# extracts from their own device, so the package carries the table and the
	# player and no audio. biscuit-earcon-map.earcon_dirs() resolves, in order,
	# /opt/persist/earcon (what the owner extracted), this directory (a stock
	# pack, if one is ever installed separately) and the eleven sounds that
	# linux-voice-assistant brings with it, which are the redistributable
	# default. With none of them present the device is silent, which is the
	# intended outcome rather than a failure.
	install -d "$pkgdir"/usr/share/biscuit/earcon

	# Per-capsule factory mic calibration, read from IDME.
	install -Dm755 "$srcdir"/biscuit-miccal.py "$pkgdir"/usr/bin/biscuit-miccal.py

	# The settings page on :8080, behind the device account.
	install -Dm755 "$srcdir"/biscuit-settings.py "$pkgdir"/usr/bin/biscuit-settings.py
	# Wi-Fi, Bluetooth and account backends the settings page loads as a
	# module. Not in the agent: none of it is exposed to Home Assistant.
	install -Dm755 "$srcdir"/biscuit-netcfg.py "$pkgdir"/usr/bin/biscuit-netcfg.py
	# Vendored rather than fetched from a CDN: the setup AP has no internet by
	# definition, so a remote reference would simply fail at the one moment it
	# is needed. v1.0.3, byte-identical from cdnjs and unpkg.
	install -Dm644 "$srcdir"/nacl-fast.min.js "$pkgdir"/usr/share/biscuit/nacl-fast.min.js
	install -Dm755 "$srcdir"/biscuit-settings.initd "$pkgdir"/etc/init.d/biscuit-settings
	install -d "$pkgdir"/etc/runlevels/default
	ln -sf /etc/init.d/biscuit-settings "$pkgdir"/etc/runlevels/default/biscuit-settings

	# Bluetooth device identity, ensured before bluetoothd starts.
	install -Dm755 "$srcdir"/biscuit-btid.initd "$pkgdir"/etc/init.d/biscuit-btid
	ln -sf /etc/init.d/biscuit-btid "$pkgdir"/etc/runlevels/default/biscuit-btid
	install -Dm755 "$srcdir"/biscuit-portal.py "$pkgdir"/usr/bin/biscuit-portal.py
	install -Dm755 "$srcdir"/biscuit-setup.initd "$pkgdir"/etc/init.d/biscuit-setup
	# The optional apps, for the setup portal's checkboxes and the settings
	# page's Apps list: one file, so the two cannot describe an app differently.
	install -Dm644 "$srcdir"/biscuit-apps.json "$pkgdir"/usr/share/biscuit/apps.json
	# Which public release this build is, for the settings page and the
	# installer's zip name. The build is written beside it, so a reader can
	# tell the file belongs to the package it came with.
	printf 'release=%s\nbuild=%s-r%s\n' "$_release" "$pkgver" "$pkgrel" \
		> "$pkgdir"/usr/share/biscuit/release
	# What each reset option erases: read by biscuit-persist, which carries a
	# reset out at boot, and shown by the settings page before one is chosen.
	install -Dm644 "$srcdir"/biscuit-reset.conf "$pkgdir"/usr/share/biscuit/reset.conf
	# Runs apk in the background for the :8080 Apps page. Detached because a
	# 100 MB install takes minutes, which no browser will wait for.
	install -Dm755 "$srcdir"/biscuit-pkgjob.sh "$pkgdir"/usr/bin/biscuit-pkgjob.sh
	# Writes the boot image a kernel or initramfs update builds to boot_a and
	# boot_b, which no package does; the Updates page runs it on request.
	install -Dm755 "$srcdir"/biscuit-boot-update "$pkgdir"/usr/bin/biscuit-boot-update

	# Manual pairing window, for re-pairing without waiting for the service's
	# 15-second trust sweep.
	install -Dm755 "$srcdir"/pair-session.sh "$pkgdir"/usr/bin/biscuit-pair-session


	# Tell the room the device has finished booting: stock's boot_success, a
	# cyan ring that fades out. The Echo has no screen, so without this there
	# is no way to know it is up. zz- so it runs last in local.d, after
	# wifi.start, which makes it mean "booted and on the network".
	install -Dm755 "$srcdir"/zz-boot-done.start "$pkgdir"/etc/local.d/zz-boot-done.start

	# ALSA configs
	install -Dm644 "$srcdir"/asound.conf "$pkgdir"/etc/asound.conf
	install -Dm644 -t "$pkgdir"/usr/share/alsa/ucm2/MediaTek/mt8163_biscuit/ \
		"$srcdir"/HiFi.conf \
		"$srcdir"/mt8163_biscuit.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/mt8163-biscuit/
	ln -s ../../MediaTek/mt8163_biscuit/mt8163_biscuit.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/mt8163-biscuit/mt8163-biscuit.conf

	install -Dm755 "$srcdir"/usb-rndis.initd \
		"$pkgdir"/etc/init.d/usb-rndis
	install -d "$pkgdir"/etc/runlevels/default
	ln -s /etc/init.d/usb-rndis \
		"$pkgdir"/etc/runlevels/default/usb-rndis

	# Bluetooth at boot. The bluez and bluez-alsa packages install their init
	# scripts but do not enable them, so a freshly flashed device had the
	# software present and no bluetoothd running - hci0 exists (that is the
	# kernel side) but nothing can pair or play to it. bluealsa is what makes
	# the speaker usable as an A2DP sink, which is the point of the device.
	ln -s /etc/init.d/bluetooth \
		"$pkgdir"/etc/runlevels/default/bluetooth
	ln -s /etc/init.d/bluealsa \
		"$pkgdir"/etc/runlevels/default/bluealsa

	# Time sync at boot. The MT8163 RTC is not battery backed and comes up
	# reading 2069, which makes every CA certificate look expired and breaks
	# TLS device-wide - apk over https, pip, and anything talking to Home
	# Assistant. Measured on hardware: chronyd steps that 43-year error about
	# 10 s after the network is up. Nothing needing TLS should start before it.
	ln -s /etc/init.d/chronyd \
		"$pkgdir"/etc/runlevels/default/chronyd

	# mDNS at boot. Home Assistant, the Wyoming satellite and Music
	# Assistant all discover over mDNS, and stock ships avahi for the same
	# reason. dbus comes with it because avahi will not start without one.
	ln -s /etc/init.d/dbus \
		"$pkgdir"/etc/runlevels/default/dbus
	ln -s /etc/init.d/avahi-daemon \
		"$pkgdir"/etc/runlevels/default/avahi-daemon

	# hostapd and dnsmasq are installed but deliberately NOT enabled in any
	# runlevel. They exist for the first-boot setup AP, which biscuit-setup
	# starts on demand; nothing should broadcast an open network every boot.
	#
	# Two corrections to what this comment used to say. "iw list" reporting AP
	# mode is misleading: it concatenates two wiphys, and wlan0's (phy0) does
	# NOT support AP - only phy1 does. And stock does not use hostapd for this;
	# its setup network is a wpa_supplicant P2P GO on p2p0 serving a Jetty
	# server (seen tracing stock's own setup on an Echo running Fire OS). We
	# use hostapd, but on the same p2p0 interface, which is what actually
	# radiates.

	# Microphone array: the beamformer, the wrapper that sets up the two
	# things capture silently needs (UCM _enadev Mic to fire DAPM, and a
	# playback stream for the FPGA's DAC reference), and the computed
	# weights. The weights are derived from measured geometry and a
	# diffuse-field model. The stock-profile filterbank prototype is kept in a
	# separate, device-recovered asset so its provenance and purpose are clear.
	install -Dm755 biscuit-beamform "$pkgdir"/usr/bin/biscuit-beamform
	# The alternative microphone profile. Its own vendor configuration is NOT
	# shipped: release-work-20260916/profiles/import_profile_assets.py installs
	# it from the owner's firmware into /usr/share/biscuit/fireos6, and the
	# settings agent refuses to select the profile until it verifies.
	install -Dm755 biscuit-mic-fireos6 "$pkgdir"/usr/bin/biscuit-mic-fireos6
	# The Fire OS 5 chain's two vendor files are deliberately NOT shipped.
	# They are Amazon's: biscuit-stock-fbf.cfg carries its own header,
	# "generated on Mar 6 2019 from Knight AFE beamformer config files", and
	# they are the coefs_FBF.cfg and coefs_FilterBank_640.cfg that .gitignore
	# names. They were only ever here because RENAMING them off coefs_*.cfg
	# stopped the ignore pattern matching.
	#
	# Fire OS 6 was already correct - only our own frontend is packaged, never
	# its assets - so Fire OS 5 was the one-sided exception. Removing them
	# needs no new mechanism: biscuit-va-leds already lists both in
	# MIC_PROFILE_ASSETS, and mic_profile_unavailable() already greys out a
	# profile whose assets are absent. The profile now reports 'needs stock
	# files this device does not have', exactly as Fire OS 6 does.
	install -Dm755 "$srcdir"/biscuit-mic-stream.sh \
		"$pkgdir"/usr/bin/biscuit-mic-stream.sh
	# The hub owns the single capture and tees it to every branch. It was
	# absent from this package entirely, so a flash produced a device whose
	# microphone chain had no owner.
	install -Dm755 "$srcdir"/biscuit-mic-hub.py \
		"$pkgdir"/usr/bin/biscuit-mic-hub.py
	# And its service, which was missed when the script above was imported -
	# found by diffing the built package against the r164 apk still in the
	# device's own cache, not by reading anything. Without it the hub has a
	# script and no way to start: this file is what pins it off CPU 0 with
	# taskset, gives it SCHED_FIFO 44, orders it after biscuit-dsp,
	# biscuit-audio, biscuit-mic-coeff and biscuit-audio-clock, and creates
	# /run/biscuit-mic 0750 - the directory biscuit-mic-stream.sh now puts its
	# capture FIFO in. Its runlevel symlink is added to the loop below.
	install -Dm755 "$srcdir"/biscuit-mic-hub.initd \
		"$pkgdir"/etc/init.d/biscuit-mic-hub

	# The acoustic direction observer. It binds the socket biscuit-mic-hub
	# sends its windows to and publishes /run/biscuit-direction/state, which
	# is what biscuit_ring_config.direction() reads. WITHOUT IT that read
	# always returns {} and the ring's 'Point at speaker' / 'Point at noise'
	# render as background only - which is exactly how direction tracking was
	# silently dead: the observer was written and tested on Device 1, but was
	# never added to this file, so no build has ever contained it.
	install -Dm755 "$srcdir"/biscuit-direction.py \
		"$pkgdir"/usr/bin/biscuit-direction.py
	install -Dm755 "$srcdir"/biscuit-direction.initd \
		"$pkgdir"/etc/init.d/biscuit-direction

	# Ten more files the RUNNING package (r164) installs that this tree did not
	# reference at all. A build from here produced a device with no USB audio
	# gadget, no audio clock, no audio policy - which pins the FPGA SPI IRQ and
	# the capture reader to specific CPUs at SCHED_FIFO, so microphone timing
	# depends on it - and none of the Bluetooth call path.
	install -Dm755 "$srcdir"/biscuit-usbaudio \
		"$pkgdir"/usr/bin/biscuit-usbaudio
	install -Dm755 "$srcdir"/biscuit-usbmode \
		"$pkgdir"/usr/bin/biscuit-usbmode
	install -Dm755 "$srcdir"/biscuit-audio-clock.py \
		"$pkgdir"/usr/bin/biscuit-audio-clock.py
	install -Dm755 "$srcdir"/biscuit-audio-policy.py \
		"$pkgdir"/usr/bin/biscuit-audio-policy.py
	install -Dm755 "$srcdir"/biscuit-call-pump.py \
		"$pkgdir"/usr/bin/biscuit-call-pump.py
	install -Dm755 "$srcdir"/biscuit-mic-client.py \
		"$pkgdir"/usr/bin/biscuit-mic-client.py
	install -Dm755 "$srcdir"/biscuit-mic-restart.py \
		"$pkgdir"/usr/bin/biscuit-mic-restart.py
	# The qualification harness (3.13/3.5). It lived only on the device for
	# its whole life, so a flash silently removed the instrument the sitting
	# depends on - the same unpackaged-file trap as the earlier clean install.
	install -Dm755 "$srcdir"/qual-capture.py "$pkgdir"/usr/bin/qual-capture.py
	install -Dm755 "$srcdir"/qual-analyse.py "$pkgdir"/usr/bin/qual-analyse.py
	install -Dm755 "$srcdir"/biscuit_call_profile.py \
		"$pkgdir"/usr/bin/biscuit_call_profile.py
	install -Dm755 biscuit-call-dsp "$pkgdir"/usr/bin/biscuit-call-dsp
	install -Dm755 "$srcdir"/biscuit-usbaudio.initd \
		"$pkgdir"/etc/init.d/biscuit-usbaudio
	# The WirePlumber rules that keep the USB gadget from ever clocking the
	# graph (priority.driver -1000) and give its capture 512 frames of
	# headroom. The host can stop its isochronous clock without removing the
	# ALSA card, and an endpoint that does that must not be driving the Echo's
	# microphone or speaker. Third file missed at import.
	install -Dm644 "$srcdir"/51-biscuit-usb-gadget.conf \
		"$pkgdir"/etc/wireplumber/wireplumber.conf.d/51-biscuit-usb-gadget.conf
	install -Dm644 "$srcdir"/52-biscuit-no-stream-restore.conf \
		"$pkgdir"/etc/wireplumber/wireplumber.conf.d/52-biscuit-no-stream-restore.conf
	install -Dm644 "$srcdir"/ramoops.conf \
		"$pkgdir"/etc/modules-load.d/ramoops.conf
	install -Dm755 "$srcdir"/biscuit-audio-clock.initd \
		"$pkgdir"/etc/init.d/biscuit-audio-clock
	install -Dm755 "$srcdir"/biscuit-mic-direct.sh \
		"$pkgdir"/usr/bin/biscuit-mic-direct.sh
	install -Dm644 "$srcdir"/biscuit-beam-weights.bin \
		"$pkgdir"/usr/share/biscuit/biscuit-beam-weights.bin
	# The package feed's PUBLIC key. Shipped so biscuit-persist can put it
	# back into /etc/apk/keys after a flash, which replaces the rootfs and
	# would otherwise leave the device unable to verify its own updates.
	install -Dm644 "$srcdir"/biscuit-apk.rsa.pub \
		"$pkgdir"/usr/share/biscuit/biscuit-apk.rsa.pub
	# Empties apk's package cache after every transaction. apk-tools 3
	# predownloads each package into /var/cache/apk and keeps it, which had
	# filled 1.2 GB of the 3.1 GB root by r271; see the hook itself.
	install -Dm755 "$srcdir"/biscuit-apk-cache-clean \
		"$pkgdir"/etc/apk/commit_hooks.d/biscuit-cache-clean
	# Size-capped file logger for daemons that write their output straight to
	# a file with nothing to rotate it (biscuit-pipewire's three).
	install -Dm755 "$srcdir"/biscuit-logcap "$pkgdir"/usr/bin/biscuit-logcap
	install -Dm644 "$srcdir"/biscuit-beam-weights-stock.bin \
		"$pkgdir"/usr/share/biscuit/biscuit-beam-weights-stock.bin

	# Loopback stanza. Wi-Fi is brought up by wifi.start, not by the
	# networking service - but the file still has to parse. Shipping it
	# empty made ifquery fail, which made networking fail, which silently
	# blocked every service declaring `need net`. chronyd is one, so the
	# RTC fix from pkgrel 36 never actually ran and the clock stayed at
	# 2069 with TLS broken device-wide.
	install -Dm644 "$srcdir"/interfaces "$pkgdir"/etc/network/interfaces

	# Stop udev autoloading the WLAN driver; wifi.start loads it instead.
	# Measured: autoload at t~9-16 s produced wlan0 on roughly 1 boot in 4,
	# deferring it to wifi.start gave 9 in 11. Both radios share one CONSYS
	# and BT/WMT enables the Wi-Fi function at t~1.7 s, so the early load
	# catches the chip in a state the firmware download cannot recover from.
	install -Dm644 "$srcdir"/wlan-defer.conf \
		"$pkgdir"/etc/modprobe.d/wlan-defer.conf
	# Home Assistant voice satellite, ring/LED peripheral, its private
	# aarch64-musl virtualenv, and TFLite runtime. They were previously
	# hand-installed on the test device, which meant a flash silently deleted
	# the working configuration and reinstallation selected a moving LVA HEAD.
	# The archive is intentionally Python 3.14/aarch64-musl specific.
	install -Dm755 "$srcdir"/biscuit-va-leds.py \
		"$pkgdir"/usr/bin/biscuit-va-leds.py
	install -Dm755 "$srcdir"/biscuit-ring-fx.py \
		"$pkgdir"/usr/bin/biscuit-ring-fx.py
	# biscuit-ring.py imports this by name. It was on the device owned by NO
	# package at all - `apk info -W` could not find one - so it existed only
	# because someone had copied it there by hand, and the first flash would
	# have left the ring unable to import it.
	install -Dm644 "$srcdir"/biscuit_ring_config.py \
		"$pkgdir"/usr/bin/biscuit_ring_config.py
	# biscuit-va-leds.py and biscuit-settings.py BOTH do
	# `import biscuit_services as services`, and this module was in no package
	# at all. The running device had it installed by hand, so nothing showed
	# until a clean flash: then va-leds died outright, and settings
	# crash-looped under supervise-daemon while `rc-service status` still
	# reported "started" and :8080 simply did not answer. A supervised
	# service reporting started says the SUPERVISOR is up, not the child.
	install -Dm644 "$srcdir"/biscuit_services.py \
		"$pkgdir"/usr/bin/biscuit_services.py
	# Apps, updates and Home Assistant status for the settings page, which
	# imports it as `system` - the same way, with the same consequence if it
	# is ever left out.
	install -Dm644 "$srcdir"/biscuit_system.py \
		"$pkgdir"/usr/bin/biscuit_system.py
	install -Dm755 "$srcdir"/biscuit-voice-assistant.initd \
		"$pkgdir"/etc/init.d/biscuit-voice-assistant
	install -Dm755 "$srcdir"/biscuit-voice-assistant-wait.sh \
		"$pkgdir"/usr/bin/biscuit-voice-assistant-wait.sh
	install -Dm755 "$srcdir"/biscuit-va-leds.initd \
		"$pkgdir"/etc/init.d/biscuit-va-leds
	install -Dm755 "$srcdir"/biscuit-pipewire.initd \
		"$pkgdir"/etc/init.d/biscuit-pipewire
	install -Dm755 "$srcdir"/biscuit-mic-pump.initd \
		"$pkgdir"/etc/init.d/biscuit-mic-pump
	install -Dm644 "$srcdir"/10-biscuit-sink.conf \
		"$pkgdir"/etc/pipewire/pipewire.conf.d/10-biscuit-sink.conf
	# biscuit-mic-pump USED to be deliberately absent here, because it opened
	# its own capture chain and took hw:0,2 before LVA could, leaving the
	# assistant with no microphone. That objection died with the mic hub: the
	# pump this tree now carries runs biscuit-call-pump.py, declares
	# `need biscuit-mic-hub`, and publishes only the call branch while LVA reads
	# the separate assistant socket. The hub alone owns the hardware PCM.
	#
	# The stale pre-hub pump, and the stale pre-hub biscuit-mic-direct.sh beside
	# it, were still in this tree until they were caught by diffing the built
	# package against the r164 apk in the device's own cache. Leaving them in
	# would have produced a device where the hub, the pump and LVA all opened
	# hw:0,2 against each other.
	#
	# The runlevel symlinks are all created here and the assistant's two are
	# moved into -voice below, because abuild's subpackage functions run after
	# package() and can only redistribute what package() produced.
	for _svc in biscuit-pipewire biscuit-voice-assistant biscuit-va-leds \
		biscuit-usbaudio biscuit-audio-clock biscuit-mic-hub \
		biscuit-mic-pump biscuit-direction; do
		ln -sf "/etc/init.d/$_svc" "$pkgdir"/etc/runlevels/default/$_svc
	done

	install -d "$pkgdir"/usr/lib
	# This archive is the canonical, syntax-checked live LVA source baseline.
	# The peripheral discovery, command-event, device-master-volume, and
	# disconnected-HA wake fixes are already integrated.  Reapplying the old
	# transition patches here would either fail the build as reversed patches
	# or risk partially reverting the source that was validated on hardware.
	#
	# biscuit-voice.lock.sha256 pins the two voice tarballs and the
	# requirements lock. It is installed below as the bundle's sha256sums, so
	# check it here: a repacked tarball with a stale lock fails the build
	# instead of shipping a manifest that describes some other bundle.
	( cd "$srcdir" && sha256sum -c biscuit-voice.lock.sha256 ) || {
		error "biscuit-voice.lock.sha256 does not match the voice tarballs"
		return 1
	}
	tar -xzf "$srcdir"/biscuit-voice-venv.tar.gz -C "$pkgdir"/usr/lib
	patch -d "$pkgdir"/usr/lib/linux-voice-assistant/lib/python3.14/site-packages \
		-p1 < "$srcdir"/biscuit-lva-processed-mic-profile.patch.txt
	# r108: wake-input AGC plus the direct capture command. Verified to
	# reproduce the validated live files byte-for-byte from this baseline.
	patch -d "$pkgdir"/usr/lib/linux-voice-assistant/lib/python3.14/site-packages \
		-p1 < "$srcdir"/biscuit-lva-wake-agc-direct-input.patch.txt
	# The device-master-volume fix above is described as integrated into the
	# venv baseline, but only its peripheral_api.py and __main__.py halves
	# actually are. Without this, entity.py still sets both mpv players to
	# the device volume percentage, applying the user volume a second time
	# on a cubic curve - 50% measured -18.06 dB on top of the DSP taper.
	patch -d "$pkgdir"/usr/lib/linux-voice-assistant/lib/python3.14/site-packages \
		-p1 < "$srcdir"/biscuit-lva-entity-master-volume.patch.txt
	# Cosmetic, but it was drowning the log: MediaPlayerEntity warned on every
	# broadcast command meant for another entity, so ordinary Home Assistant
	# use produced a warning per switch, number, select and light command.
	patch -d "$pkgdir"/usr/lib/linux-voice-assistant/lib/python3.14/site-packages \
		-p1 < "$srcdir"/biscuit-lva-quiet-broadcast-warning.patch.txt

	# The venv baseline plus the four patches above does NOT reproduce what runs
	# on hardware. Measured: peripheral_api.py, entity.py, __main__.py and
	# satellite.py all differ, and qualification_v1.py - which the deployed
	# satellite.py and __main__.py both import - was missing from the package
	# entirely, so a rebuilt tree could not even start.
	#
	# The most serious drift: the deployed __main__.py no longer carries
	# --peripheral-host/--peripheral-port, because the peripheral WebSocket was
	# moved off 0.0.0.0:6055 to a root-only Unix socket. Rebuilding from the
	# baseline alone would REINTRODUCE an unauthenticated network service that
	# can unmute the microphone and start a listening session.
	#
	# These five files are therefore the authority, copied last. They are the
	# validated live source, and keeping them as plain files rather than
	# patches means the next drift shows up as a reviewable diff.
	# peripheral_transport.py implements the root-only unix socket the
	# peripheral API moved to, replacing the old ws://127.0.0.1:6055. It was
	# NOT packaged: the hardening shipped peripheral_api.py and __main__.py
	# but not the module biscuit-va-leds.py imports at line 2708. The device
	# had it by hand, so it only surfaced on a clean flash, as the SECOND
	# ModuleNotFoundError after biscuit_services.py.
	for _f in peripheral_api.py entity.py __main__.py satellite.py \
		qualification_v1.py mpv_player.py peripheral_transport.py; do
		# abuild flattens sources into $srcdir by BASENAME, so the lva-src/
		# prefix belongs in source= and must not appear here.
		install -Dm644 "$srcdir"/$_f \
			"$pkgdir"/usr/lib/linux-voice-assistant/lib/python3.14/site-packages/linux_voice_assistant/$_f
	done
	# libmpv.py lives one directory deeper, so it cannot join the loop above.
	#
	# It and mpv_player.py were BOTH absent from this tree while the device ran
	# modified copies of them - `apk audit` is what found that. They carry the
	# ao/ device-prefix fix, without which a bare node name plays silently and
	# wedges the voice pipeline, and the volume-curve fix, without which mpv's
	# cubic taper turns device volume 50 into -28 dB instead of -10. A build
	# from this tree shipped upstream's versions and lost both.
	install -Dm644 "$srcdir"/libmpv.py \
		"$pkgdir"/usr/lib/linux-voice-assistant/lib/python3.14/site-packages/linux_voice_assistant/player/libmpv.py
	# models.py is the one changed LVA file with no lva-src/ copy: the venv
	# baseline already carries the peripheral registrations and the patches
	# above add the rest. Apache-2.0 section 4(b) wants a change notice in it,
	# as the lva-src/ files carry. It goes first, or after a shebang or PEP 263
	# encoding line if the file ever gains one. Every other file of the package
	# that has no notice is byte-identical to upstream at b0c53c41c11e.
	_lvamodels="$pkgdir"/usr/lib/linux-voice-assistant/lib/python3.14/site-packages/linux_voice_assistant/models.py
	if ! grep -q "MODIFIED FILE" "$_lvamodels"; then
		cat > "$srcdir"/models.py.notice <<-EOF
		# SPDX-License-Identifier: Apache-2.0
		#
		# MODIFIED FILE. This is a changed copy of
		# linux_voice_assistant/models.py from OHF-Voice/linux-voice-assistant
		# at commit b0c53c41c11e,
		#   https://github.com/OHF-Voice/linux-voice-assistant
		# licensed under the Apache License 2.0 (LICENSES/Apache-2.0.txt).
		# Changed by liamtw22 and contributors, 2026, for the Amazon Echo Dot
		# (2nd gen) postmarketOS port. The upstream copyright is unchanged.
		# Changes: sensor, switch and number registrations for peripherals;
		#   the processed-microphone profile; wake-input gain and AGC settings;
		#   atomic, locked preference saves (biscuit-voice-venv.tar.gz,
		#   biscuit-lva-processed-mic-profile.patch.txt and
		#   biscuit-lva-wake-agc-direct-input.patch.txt in pmaports-biscuit).
		EOF
		awk 'NR == FNR { n = n $0 "\n"; next }
			!done && !((FNR == 1 && /^#!/) || (FNR <= 2 && /^#.*coding[:=]/)) { printf "%s", n; done = 1 }
			{ print }
			END { if (!done) printf "%s", n }' \
			"$srcdir"/models.py.notice "$_lvamodels" > "$_lvamodels".new
		mv "$_lvamodels".new "$_lvamodels"
		chmod 644 "$_lvamodels"
	fi
	# A rebuild that silently drops the socket fix is the failure this guards.
	if grep -q "peripheral-host" "$pkgdir"/usr/lib/linux-voice-assistant/lib/python3.14/site-packages/linux_voice_assistant/__main__.py; then
		error "LVA still exposes the peripheral API on a network socket"
		return 1
	fi
	# PROVENANCE: TensorFlow Lite 2.17.0's C API, built by this project for
	# aarch64/musl, with its Abseil, fft2d, farmhash, cpuinfo and pthreadpool
	# libraries beside it. Apache-2.0, MIT, BSD-2-Clause and Ooura's licence,
	# plus Eigen compiled in under the MPL-2.0 (weak copyleft, per file).
	# Nothing in it is Amazon's. It is built rather than fetched because both
	# wake engines ship an x86-64/glibc libtensorflowlite_c.so that cannot
	# load on this target at all. The tarball carries THIRD_PARTY_LICENSES/
	# with every component's licence, the pinned commits and the build steps.
	install -d "$pkgdir"/usr/lib/biscuit-tflite
	tar -xzf "$srcdir"/tflite-aarch64-musl.tar.gz \
		-C "$pkgdir"/usr/lib/biscuit-tflite

	# Make both wake engines' absolute-path loads resolve to the one verified
	# aarch64-musl build shipped directly above; the init service exposes its
	# dependencies through LD_LIBRARY_PATH as well. Their upstream x86-64
	# glibc copies are no longer in the venv tarball (r294), so pyopen_wakeword
	# gets a link where it had a file.
	for _wake_lib in \
		"$pkgdir"/usr/lib/linux-voice-assistant/lib/python3.14/site-packages/pymicro_wakeword/lib/libtensorflowlite_c.so \
		"$pkgdir"/usr/lib/linux-voice-assistant/lib/python3.14/site-packages/pyopen_wakeword/lib/libtensorflowlite_c.so; do
		ln -sf /usr/lib/biscuit-tflite/libtensorflowlite_c.so "$_wake_lib"
	done
	# openWakeWord's pretrained wake-word models are CC BY-NC-SA 4.0
	# (non-commercial) and were removed from the venv tarball in r294; the
	# assistant runs microWakeWord. A venv rebuilt with pip brings them back,
	# so refuse to ship them. See THIRD_PARTY_LICENSES/README.txt in the venv.
	if find "$pkgdir"/usr/lib/linux-voice-assistant \
		\( -path '*/wakewords/openWakeWord*' -o -name '*_v0.1.tflite' \
		-o \( -path '*/pyopen_wakeword/models/*' ! -name melspectrogram.tflite \
		! -name embedding_model.tflite \) \) | grep -q .; then
		error "openWakeWord pretrained models are back in the voice venv"
		return 1
	fi
	install -Dm644 "$srcdir"/biscuit-voice.requirements.lock \
		"$pkgdir"/usr/share/doc/$pkgname/voice-bundle/requirements.lock
	install -Dm644 "$srcdir"/biscuit-voice.lock.sha256 \
		"$pkgdir"/usr/share/doc/$pkgname/voice-bundle/sha256sums

	# sendspin: the network-speaker application. Same shape as the voice
	# bundle - an aarch64-musl virtualenv against this image's Python 3.14,
	# archived rather than pip-installed at build time because Alpine's
	# builder has no network during build(). It was hand-installed until now,
	# which meant every flash silently deleted 141 MB of working application.
	tar -xzf "$srcdir"/biscuit-sendspin-venv.tar.gz -C "$pkgdir"/usr/lib
	# Ask Music Assistant for the visualiser and colour roles. The daemon
	# hardcodes [Roles.PLAYER], so nothing ever requested them - the server
	# supports both and grants them immediately when asked. The roles must
	# sit on the PLAYER: a standalone visualiser client is granted them too
	# but never gets a stream/start, so every frame is dropped before the
	# callback. Measured both ways.
	#
	# Named .diff, NOT .patch: abuild's default_prepare applies every
	# *.patch in source= against $builddir, and this one targets the venv
	# extracted here in package() instead. As a .patch it failed prepare
	# with "4 out of 4 hunks ignored" before the build even started.
	#
	# --fuzz=0 deliberately: if a sendspin update moves this code the build
	# must FAIL here rather than quietly shipping a player with no
	# visualiser, which is exactly the kind of silent regression that is
	# hard to notice from the outside.
	install -Dm644 "$srcdir"/biscuit_sendspin_viz.py \
		"$pkgdir"/usr/lib/sendspin/lib/python3.14/site-packages/biscuit_sendspin_viz.py
	( cd "$pkgdir"/usr/lib/sendspin/lib/python3.14/site-packages \
		&& patch -p1 --fuzz=0 < "$srcdir"/sendspin-visualizer-roles.diff )
	# The server advertises seek and seek_relative, which the vendored
	# MediaCommand enum does not have; one unknown member discards the
	# whole server/state message. Same --fuzz=0 reasoning: if an update
	# adds them upstream this must fail here, not apply somewhere else.
	( cd "$pkgdir"/usr/lib/sendspin/lib/python3.14/site-packages \
		&& patch -p1 --fuzz=0 < "$srcdir"/sendspin-media-commands.diff )
	# The visualiser on the client-initiated path too (r280): the roles
	# patch attaches it only where the server connects in. Generated against
	# a tree with both patches above applied, so it goes last.
	( cd "$pkgdir"/usr/lib/sendspin/lib/python3.14/site-packages \
		&& patch -p1 --fuzz=0 < "$srcdir"/sendspin-client-visualizer.diff )
	# Apache-2.0 4(b): a file we changed says so, at the top where it is seen.
	for _f in aiosendspin/models/controller.py aiosendspin/models/types.py \
			sendspin/daemon/daemon.py; do
		sed -i "1i # Modified by liamtw22 and contributors for the Echo Dot 2 port (sendspin-*.diff in pmaports-biscuit)." \
			"$pkgdir"/usr/lib/sendspin/lib/python3.14/site-packages/$_f
	done
	install -Dm755 "$srcdir"/biscuit-sendspin.initd \
		"$pkgdir"/etc/init.d/biscuit-sendspin
	# Finds the Music Assistant server over mDNS so sendspin can connect out
	# to it (2.31, r280). Runs on the venv's Python, which has zeroconf.
	install -Dm755 "$srcdir"/biscuit-sendspin-server.py \
		"$pkgdir"/usr/bin/biscuit-sendspin-server
	# Routes sendspin volume to biscuit-audio, so there is ONE device
	# volume. Without it sendspin attenuates inside its own stream, the
	# volume ring never lights, and the slider, Home Assistant and the
	# actual loudness disagree.
	install -Dm755 "$srcdir"/biscuit-sendspin-volume.sh \
		"$pkgdir"/usr/bin/biscuit-sendspin-volume
	# Stream start/stop: wakes the codec (the DSP releases it after ten
	# seconds of silence, which swallows the start of the next track) and
	# shows the music animation on the ring.
	install -Dm755 "$srcdir"/biscuit-sendspin-stream.sh \
		"$pkgdir"/usr/bin/biscuit-sendspin-stream
	# The backstop behind connecting out (2.31): restarts sendspin when it
	# has had no Music Assistant connection for two minutes, or has crashed,
	# backing off to hourly.
	install -Dm755 "$srcdir"/biscuit-sendspin-watchdog.sh \
		"$pkgdir"/usr/bin/biscuit-sendspin-watchdog
	install -Dm755 "$srcdir"/biscuit-sendspin-watchdog.initd \
		"$pkgdir"/etc/init.d/biscuit-sendspin-watchdog
	ln -sf /etc/init.d/biscuit-sendspin-watchdog \
		"$pkgdir"/etc/runlevels/default/biscuit-sendspin-watchdog
	ln -sf /etc/init.d/biscuit-sendspin \
		"$pkgdir"/etc/runlevels/default/biscuit-sendspin

}

voice() {
	pkgdesc="Voice assistant for the Amazon Echo Dot (2nd gen)"
	# The linux-voice-assistant fork (Apache-2.0, modified - lva-src/) and a
	# virtualenv of third-party packages, each with its own licence text
	# shipped in the bundle. The copyleft ones are zeroconf (LGPL-2.1+),
	# autocommand (LGPL-3.0), python-mpv (GPL-2.0+ or LGPL-2.1+), the GCC
	# runtime bundled in two wheels (GPL-3.0+ with the runtime exception) and
	# Eigen in the TFLite build (MPL-2.0). The LVA sounds are CC-BY-4.0, and
	# Ooura's FFT (in TFLite and WebRTC) has its own permissive notice.
	# PROVENANCE.md enumerates every distribution.
	license="Apache-2.0 AND MIT AND MIT-0 AND BSD-2-Clause AND BSD-3-Clause AND PSF-2.0 AND MPL-2.0 AND LGPL-2.1-or-later AND LGPL-3.0-only AND (GPL-2.0-or-later OR LGPL-2.1-or-later) AND GPL-3.0-or-later WITH GCC-exception-3.1 AND CC-BY-4.0 AND LicenseRef-Ooura"
	# An application, not the device. Core is a working Bluetooth speaker with
	# a settings page; this is what makes it answer to a wake word. Offered as
	# a checkbox during first-boot setup - see biscuit-apps.json.
	#
	# mpv the PLAYER is NOT here: it stays in core by decision, as the obvious
	# backend if core ever gains a media player of its own. mpv-libs IS here,
	# and the two are separate packages in Alpine: core's `mpv` installs the
	# CLI, while the venv's `mpv.py` dlopens libmpv.so and fails at import with
	# "Cannot find libmpv in the usual places" without it.
	#
	# THE VENV IS --system-site-packages, SO SOME IMPORTS RESOLVE OUTSIDE IT.
	# openblas and libstdc++ were declared because they come in behind numpy and
	# the TFLite runtime - but the things they sit behind were never declared
	# themselves, so a clean install of this subpackage crash-looped on
	# ModuleNotFoundError. Every entry below was verified by REMOVING it and
	# watching the assistant fail, not by reading the old install recipe:
	#
	#   py3-numpy    numpy resolves to /usr/lib/python3.14, not the venv
	#   py3-aiohttp  likewise
	#   py3-ifaddr   the venv HAS zeroconf, but zeroconf imports ifaddr, which
	#                it does not vendor - py3-zeroconf is NOT needed and pulling
	#                it in was what accidentally satisfied ifaddr before
	#   mpv-libs     libmpv.so for the player binding
	#
	# portaudio is deliberately absent: the recipe this bundle came from listed
	# it, but nothing in the venv links or imports it - soundcard talks to
	# PulseAudio through cffi. Verified with readelf and an import sweep.
	depends="$pkgname=$pkgver-r$pkgrel openblas libstdc++ py3-numpy py3-aiohttp py3-ifaddr mpv-libs"

	# NOT biscuit-va-leds.py. That file is imported as a LIBRARY by
	# biscuit-settings.py, biscuit-ring.py, biscuit-earcon-map.py,
	# biscuit-earcon-args and biscuit-netcfg.py - moving it would take the
	# whole :8080 settings page with it. Only the SERVICE moves: the
	# peripheral agent talks to the assistant's websocket on 6053/6055 and has
	# nothing to talk to without it.
	#
	# Core keeps working without this subpackage because biscuit-settings
	# publishes /opt/persist/led-anim.env at start-up, so wifi.start,
	# biscuit-setup.sh and biscuit-btring still resolve their animation names.
	amove usr/lib/linux-voice-assistant
	amove usr/lib/biscuit-tflite
	amove usr/bin/biscuit-voice-assistant-wait.sh
	amove etc/init.d/biscuit-voice-assistant
	amove etc/init.d/biscuit-va-leds
	amove etc/runlevels/default/biscuit-voice-assistant
	amove etc/runlevels/default/biscuit-va-leds
	amove usr/share/doc/$pkgname/voice-bundle
}

sendspin() {
	pkgdesc="Network audio speaker (Music Assistant target) for the Echo Dot"
	# Sendspin (Apache-2.0, patched by the sendspin-*.diff files) and its
	# virtualenv, each distribution with its own licence text. The copyleft
	# ones are textual-image (LGPL-3.0+), Unidecode (GPL-2.0+) and orjson's
	# MPL-2.0 part. Pillow's LICENSE covers the image libraries its wheel
	# bundles (FreeType, libjpeg, libpng, libtiff and others). PROVENANCE.md
	# enumerates every distribution.
	license="Apache-2.0 AND MIT AND MIT-0 AND MIT-CMU AND BSD-2-Clause AND BSD-3-Clause AND MPL-2.0 AND LGPL-3.0-or-later AND GPL-2.0-or-later AND FTL AND IJG AND libpng-2.0 AND libtiff"
	# An application, not the device - and the largest single component here at
	# about 141 MB installed. portaudio is its audio backend and nothing in core
	# uses it, so it comes with this rather than with every install.
	# py3-zeroconf: the venv is built with include-system-site-packages, so it
	# resolves this from the system rather than carrying its own copy - and it
	# was never declared. sendspin crashed on every start with
	#   ModuleNotFoundError: No module named 'zeroconf'
	# from aiosendspin.client.listener, which is imported before anything is
	# logged, so the service looked started and simply never served.
	#
	# This does NOT contradict the voice bundle above, which says py3-zeroconf
	# is not needed. They are different venvs: the VOICE venv vendors zeroconf
	# and only needs ifaddr behind it; the SENDSPIN venv does not vendor it at
	# all. Check the venv you are actually shipping, not the other one.
	# ffmpeg-libs: av is built FROM SOURCE against the distro FFmpeg rather than
	# installed from the PyPI wheel, which bundles its own copy including
	# libx264 and libx265 and a --enable-gpl libavcodec. That made this package
	# a redistributor of GPL binaries with no corresponding source, for three
	# AUDIO codecs: flac in, flac out, opus out. Linking the distro build instead
	# leaves the GPL libraries to Alpine, which already ships them here for mpv,
	# and drops 23 MB from this package.
	depends="$pkgname=$pkgver-r$pkgrel portaudio py3-zeroconf ffmpeg-libs"
	amove usr/lib/sendspin
	amove etc/init.d/biscuit-sendspin
	amove usr/bin/biscuit-sendspin-volume
	amove usr/bin/biscuit-sendspin-stream
	amove etc/runlevels/default/biscuit-sendspin
	amove usr/bin/biscuit-sendspin-watchdog
	amove etc/init.d/biscuit-sendspin-watchdog
	amove etc/runlevels/default/biscuit-sendspin-watchdog
}

pulseaudio() {
	pkgdesc="PulseAudio Configuration Files"
	license="MIT"
	install_if="$pkgname=$pkgver-r$pkgrel pulseaudio"
	install -Dm644 "$srcdir"/pulse-daemon-biscuit.conf \
		"$subpkgdir"/etc/pulse/daemon.conf.d/daemon-biscuit.conf
	install -Dm644 "$srcdir"/pulse-default-biscuit.pa \
		"$subpkgdir"/etc/pulse/default.pa.d/default-biscuit.pa
}

nonfree_firmware() {
	pkgdesc="Owner-imported vendor firmware in the initramfs"
	# MIT: this ships only our mkinitfs list. The firmware it names is the
	# owner's own, imported from their device, and is never in this package.
	license="MIT"
	#
	# This ships NO firmware. It ships the list that tells mkinitfs to put
	# the owner's own imported firmware into the initramfs cpio, which is
	# the only place the FPGA and Bluetooth drivers can reach it: they are
	# built in and ask at t=0.61 s and t=0.93-1.00 s, while the root
	# filesystem arrives at t=7.4 s. The kernel unpacks the initramfs at
	# rootfs_initcall, before device_initcall, so a copy in the cpio is in
	# time and a file on disk is not.
	#
	# Installing this alone does nothing useful. The owner must also run
	#     biscuit-import-assets import <export> --profile firmware
	# and regenerate the initramfs. Without it the device boots with no
	# audio and no Bluetooth, which is the intended, visible failure - the
	# FPGA carries the I2S passthrough.
	install -Dm644 "$srcdir"/30-biscuit-firmware.files -t \
		"$subpkgdir"/usr/share/mkinitfs/files
}

