#!/sbin/openrc-run
# Bluetooth hands-free call audio.
#
# The bridge idles cheaply: hw:0,3 returns an error until a SCO link exists, so
# it simply retries and the failed open IS the call detector. No D-Bus, nothing
# to fall out of step with bluealsa, and no state to get stuck in.
#
# bluealsa still handles the HFP control channel over RFCOMM - the AT commands,
# the SDP record, the phone's "Phone calls" toggle. Only the audio comes this
# way, because on this SoC it never crosses HCI at all: the firmware leaves a
# CVSD bitstream in a shared SRAM bank that mtk-btcvsd exposes as hw:0,3.

name="biscuit-btcall"
description="Bluetooth hands-free call audio bridge"

# Keep audio off CPU 0, which handles USB/SPI interrupt bursts, and run it at
# a realtime priority like the rest of the chain.
#
# The priority is not cosmetic. This was the only audio consumer left at
# SCHED_OTHER while the hub runs FIFO 44 and the assistant's audio thread runs
# FIFO 10, on the same CPUs 1-3 where the hub alone burns about half a core.
# Measured over a two-hour idle: btcall waited 53.1 s for a CPU against 17.0 s
# of runtime - a 3.1:1 ratio, against 0.07:1 for the hub and 0.03:1 for the
# assistant. A consumer descheduled that hard backs its branch up, which is
# what the hub's call branch peaking at 32 of 32 with a 294 ms drain_max is,
# and on a boot with a live call it overflowed twice and dropped 80 blocks.
#
# 20 sits above the assistant and below the hub deliberately: SCO frames are
# far shorter than the assistant's 64 ms block, so this must preempt it, while
# the producer must always outrank both. The runtime added is negligible -
# 17 s in two hours - so this costs essentially no RT utilisation against the
# 95% throttle, it only makes the wakeups prompt.
# exec inheritance also covers subprocesses and supervised restarts.
command="/usr/bin/taskset"
command_args="-c 1-3 /usr/bin/chrt -f 20 /usr/bin/env XDG_RUNTIME_DIR=/run/pipewire PULSE_RUNTIME_PATH=/run/pipewire/pulse /usr/bin/biscuit-btcall ${BTCALL_ARGS:---duplex --out default}"
command_background="yes"
pidfile="/run/biscuit-btcall.pid"
# Logged through a pipe, not straight to the file. This service runs at
# realtime priority, and a write to the ext4 root can stall for most of a
# second behind the journal while something else writes (3.8: the call DSP
# did exactly that and its branch overflowed). OpenRC hands the output to a
# cat at ordinary priority instead, which takes any such stall; the pipe
# absorbs 64 KiB meanwhile.
output_logger="cat >> /var/log/biscuit-btcall.log"
error_logger="cat >> /var/log/biscuit-btcall.log"
respawn_delay=5
respawn_max=0

depend() {
	need localmount biscuit-mic-pump biscuit-pipewire
	# bluealsa owns the control channel; without it a call never reaches the
	# point of opening a SCO link and this has nothing to carry.
	after bluealsa bluetooth
	# The far-end audio is written into PipeWire so the device's own volume,
	# EQ and ducking apply, exactly as A2DP playback already does.
	after biscuit-audio
}
