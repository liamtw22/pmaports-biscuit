#!/sbin/openrc-run
name="biscuit-audio-clock"
description="Keep audio loopback clocks stable during system time correction"
command="/usr/bin/taskset"
command_args="-c 1-3 /usr/bin/python3 /usr/bin/biscuit-audio-clock.py"
supervisor="supervise-daemon"
respawn_delay=1
respawn_max=0
output_log="/var/log/biscuit-audio-clock.log"
error_log="/var/log/biscuit-audio-clock.log"
depend() {
    # DSP startup loads snd-aloop; start correction before either audio consumer.
    need biscuit-dsp
    before biscuit-pipewire biscuit-mic-hub
}
start_pre() {
    checkpath -d -m 0755 /run/biscuit-audio-clock
    rm -f /run/biscuit-audio-clock/status.json
}
start_post() {
    # Check readiness, not just existence of a supervised process.
    i=0
    while [ "$i" -lt 30 ]; do
        if grep -q '"ready": true' /run/biscuit-audio-clock/status.json 2>/dev/null; then
            return 0
        fi
        sleep 0.1
        i=$((i + 1))
    done
    eerror "audio clock controls did not become ready"
    return 1
}
