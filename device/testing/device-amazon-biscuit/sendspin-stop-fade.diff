+    # 10 ms at 48 kHz. Music starting mid-waveform out of silence - a track
+    # start, a resume - is the same step as stopping on one, the other way.
+    _FADE_IN_FRAMES: Final = 480
+
+    def _fade_in(self, output_buffer: memoryview) -> None:
+        """Ramp the output up where it goes from silence to sound."""
+        assert self._format is not None
+        frame_size = self._format.frame_size
+        width = self._format.bit_depth // 8
+        n_frames = len(output_buffer) // frame_size
+        if n_frames == 0:
+            return
+        start = 0
+        if self._fade_in_left == 0:
+            if self._output_silent:
+                data = bytes(output_buffer)
+                sound = data.lstrip(b"\x00")
+                if sound:
+                    start = (len(data) - len(sound)) // frame_size
+                    self._fade_in_left = self._FADE_IN_FRAMES
+        if self._fade_in_left > 0:
+            total = self._FADE_IN_FRAMES
+            count = min(self._fade_in_left, n_frames - start)
+            done = total - self._fade_in_left
+            for f in range(start, start + count):
+                gain = (done + f - start + 1) / total
+                for pos in range(f * frame_size, (f + 1) * frame_size, width):
+                    v = int.from_bytes(output_buffer[pos : pos + width], "little", signed=True)
+                    output_buffer[pos : pos + width] = int(v * gain).to_bytes(
+                        width, "little", signed=True
+                    )
+            self._fade_in_left -= count
+        # Silence means a run of zero frames, not one: music crosses zero on
+        # both channels at once now and then, and a fade in started there
+        # would dip the music.
+        self._output_silent = not any(output_buffer[-32 * frame_size :])
+
+    def _wait_for_tail(self, stream: sounddevice.RawOutputStream) -> None:
+        """Block (executor thread) until the fade out has been played.
+
+        Written is not enough: stopping the stream discards whatever is still
+        buffered between here and PipeWire - measured, the cut landed mid-music
+        with the fade never heard. So wait for the callback to write the fade,
+        then for the output latency to play it out.
+        """
+        self._tail_silent.wait(0.25)
+        try:
+            latency = float(stream.latency)
+        except Exception:  # noqa: BLE001 - a closed stream has none
+            latency = 0.0
+        time.sleep(min(max(latency, 0.0), 0.5) + 0.02)
+
+    # Per-frame gain of the fade out: -60 dB in 5 ms at 48 kHz. Truncating
+    # toward zero, rather than rounding, makes it reach exact silence.
+    _DECAY_PER_FRAME: Final = 10 ** (-3 / 240)
+
+    def _decay_frames(self, last_frame: bytes, n_frames: int) -> bytes:
+        """N frames continuing from last_frame, decaying to silence."""
+        assert self._format is not None
+        frame_size = self._format.frame_size
+        width = self._format.bit_depth // 8
+        if n_frames <= 0:
+            return b""
+        if len(last_frame) != frame_size or not any(last_frame):
+            return b"\x00" * (n_frames * frame_size)
+        values = [
+            int.from_bytes(last_frame[i : i + width], "little", signed=True)
+            for i in range(0, frame_size, width)
+        ]
+        out = bytearray(n_frames * frame_size)
+        k = self._DECAY_PER_FRAME
+        pos = 0
+        for _ in range(n_frames):
+            values = [int(v * k) for v in values]
+            if not any(values):
+                break  # the rest of out is already zero
+            for v in values:
+                out[pos : pos + width] = v.to_bytes(width, "little", signed=True)
+                pos += width
+        return bytes(out)
+
     def _advance_finished_chunk(self) -> None:
         """Update durations and state when current chunk is fully consumed."""
         assert self._format is not None
