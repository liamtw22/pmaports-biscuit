#!/bin/sh
# Play the earcon for an activity.
#
#     biscuit-earcon bt_connected
#     biscuit-earcon --path bt_connected     print the file, do not play it
#     biscuit-earcon --file ui_wakesound      play an installed sound by name
#
# --file exists for the settings page's per-activity sound picker, which has to
# play a candidate BEFORE it is assigned to any activity - so there is no
# activity to look up, and the cached table cannot answer. It resolves the name
# in the earcon directory only, never a path, so an authenticated HTTP session
# cannot make the device open an arbitrary file.
#
# Shell, not Python, and it reads a cached table rather than the map agent.
# This used to exec biscuit-earcon-map.py on every call, which measured 0.28 s
# on this SoC - 0.11 s of interpreter start and 0.17 s to load the map - before
# the player was even spawned. That is why every earcon except the volume tone
# (which resolves once and caches, in biscuit-audio) arrived noticeably late
# after a button press. The cache costs one regeneration when the map changes
# and about 10 ms per call after that.
#
# The map agent remains the single source of truth; this only memoises it, and
# the cache is rebuilt whenever the overrides file or the agent itself is newer.
#
# Deliberately silent and always successful. These are called from boot and
# setup paths where a missing sound must never be the thing that fails the
# boot, and `set -e` in a caller would turn that into a fatal error.

AGENT=/usr/bin/biscuit-earcon-map.py
MAP=/opt/persist/sound-map.json
CACHE_DIR=/run/biscuit-earcon
CACHE=$CACHE_DIR/paths

# The same directories, in the same order, as earcon_dirs() in
# biscuit-earcon-map.py: what the owner extracted from their own device,
# then a stock pack if one is installed, then the sounds
# linux-voice-assistant brings with it. pmOS ships none of its own.
EARCON_DIRS="/opt/persist/earcon /usr/share/biscuit/earcon"
for d in /usr/lib/linux-voice-assistant/lib/python3.*/site-packages/sounds; do
	[ -d "$d" ] && EARCON_DIRS="$EARCON_DIRS $d"
done

path_only=0
if [ "$1" = "--path" ]; then
	path_only=1
	shift
elif [ "$1" = "--file" ]; then
	shift
	[ $# -eq 1 ] || { echo "usage: biscuit-earcon --file <name>" >&2; exit 0; }
	# A bare name, resolved in the earcon directory. Anything with a slash is
	# refused rather than sanitised: there is no legitimate caller that needs
	# one, so quietly stripping it would only hide a bug.
	case $1 in
		*/*|"") exit 0 ;;
	esac
	# --file can be the first call after a boot, before the cache directory
	# the error file lives in has been created by a table rebuild.
	mkdir -p "$CACHE_DIR" 2>/dev/null
	for d in $EARCON_DIRS; do
		for ext in .flac .wav .ogg .mp3; do
			if [ -f "$d/$1$ext" ]; then
				setsid sndfile-play "$d/$1$ext" \
					>/dev/null 2>"$CACHE_DIR/last-error" &
				exit 0
			fi
		done
	done
	exit 0
fi
[ $# -eq 1 ] || { echo "usage: biscuit-earcon [--path|--file] <activity>" >&2; exit 0; }
activity=$1

stale=0
[ -f "$CACHE" ] || stale=1
[ -f "$MAP" ] && [ "$MAP" -nt "$CACHE" ] && stale=1
[ -f "$AGENT" ] && [ "$AGENT" -nt "$CACHE" ] && stale=1

if [ "$stale" = 1 ]; then
	mkdir -p "$CACHE_DIR" 2>/dev/null
	# chr(9)/chr(10) rather than escapes: this is a shell heredoc inside a
	# Python string inside a shell script, and a backslash does not survive
	# every layer of that.
	python3 -c '
import importlib.util, sys
spec = importlib.util.spec_from_file_location("m", sys.argv[1])
agent = importlib.util.module_from_spec(spec)
spec.loader.exec_module(agent)
for activity, entry in sorted(agent.load_sound_map().items()):
    path = agent.sound_path((entry or {}).get("sound"))
    if path:
        sys.stdout.write(activity + chr(9) + path + chr(10))
' "$AGENT" > "$CACHE.tmp" 2>/dev/null && mv "$CACHE.tmp" "$CACHE" 2>/dev/null
	rm -f "$CACHE.tmp" 2>/dev/null
fi

path=$(awk -F"	" -v a="$activity" '$1 == a { print $2; exit }' "$CACHE" 2>/dev/null)

if [ "$path_only" = 1 ]; then
	# Nothing on stdout when there is no sound, so a caller can test for an
	# empty string rather than having to recognise an error message.
	[ -n "$path" ] && printf %s "$path"
	exit 0
fi

# The setup page's "Play a sound on the device" button is its check against a
# lookalike access point: only the real Echo in the room can answer it. It
# plays setup_mode, and on a fresh install no earcon exists yet - the owner's
# own are imported later and pmOS ships none of Amazon's - so the check was
# silent and could not be passed honestly. This chime is ours, generated by
# tools/make_setup_chime.py. Only when playing, so --path above still reports
# that no sound is assigned.
if [ -z "$path" ] && [ "$activity" = setup_mode ]; then
	path=/usr/share/biscuit/biscuit-setup-chime.wav
	[ -f "$path" ] || path=
fi

[ -n "$path" ] || exit 0

# Detached, so a caller that exits immediately - which the setup and Bluetooth
# paths do - does not cut the sound off partway through. stderr is kept, in one
# fixed-size file on tmpfs, because sndfile-play reports "cannot open audio
# device" and still exits 0: this failure mode was invisible for a long time.
setsid sndfile-play "$path" >/dev/null 2>"$CACHE_DIR/last-error" &
exit 0
