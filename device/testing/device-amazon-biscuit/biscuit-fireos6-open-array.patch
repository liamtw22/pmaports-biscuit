+/* OPEN COEFFICIENTS (--open-coefficients): the two things this frontend
+ * otherwise reads from Amazon's files, designed here from first principles so
+ * the chain needs no vendor asset at all.
+ *
+ * Prototype: a 768-tap Kaiser-windowed sinc (beta 8, -6 dB at 0.65 of a bin),
+ * the textbook oversampled-DFT-filterbank lowpass. Its analysis/synthesis round
+ * trip through this file's WOLA measures a -24.2 dB residual on white noise,
+ * the same as the vendor prototype's -24.4 dB. It is scaled to a DC gain of
+ * OPEN_PROTO_DC so every level-dependent constant downstream (the 2*HOP
+ * synthesis normaliser, the adaptive stage's floors, --gain 13) keeps the level
+ * it was tuned at.
+ *
+ * Beams: diffuse-field superdirective (MVDR with diagonal loading 0.05) for the
+ * four capsules this frontend reads - MK2, MK3, MK5 and MK6 at their measured
+ * positions (tools/beamform/biscuit-mic-array.json) - steered to 150 - 45*b
+ * degrees, distortionless (unity gain) in the look direction, one tap per bin.
+ * The adaptive stage's references {b+3, b+5} assume eight beams in circular
+ * order, which this preserves.
+ *
+ * Measured on the 2026-09-24 captures with --adaptive --adapt-mask 255
+ * --no-aec --clean-on-echo and no VAD: barge-in 48/50 (production pmOS 31),
+ * quiet 50/50/49 at 1/4/8 m (pmOS 50/50/49), and 49/50/49 on quiet prompts
+ * straight after three minutes of music. */
+#define OPEN_PROTO_BETA 8.0
+#define OPEN_PROTO_CUTOFF 1.3
+#define OPEN_PROTO_DC 10.8933
+#define OPEN_LOADING 0.05
+#define OPEN_SOUND 343.0
+static const double open_mic_mm[M][2]={{-31.18,-18.0},{0.0,-36.0},{31.18,18.0},{0.0,36.0}};
+static double bessel_i0(double x) {
+    double sum=1,term=1;
+    for(int k=1;k<200;k++){term*=(x/(2*k))*(x/(2*k));sum+=term;if(term<1e-17*sum)break;}
+    return sum;
+}
+static double sinc_pi(double x) {return fabs(x)<1e-12?1.0:sin(PI*x)/(PI*x);}
+/* Solve the real 4x4 system a*x=b in place (partial pivoting). */
+static void solve4(double a[M][M],double *b) {
+    for(int c=0;c<M;c++){
+        int piv=c;for(int r=c+1;r<M;r++)if(fabs(a[r][c])>fabs(a[piv][c]))piv=r;
+        for(int j=0;j<M;j++){double t=a[c][j];a[c][j]=a[piv][j];a[piv][j]=t;}
+        double t=b[c];b[c]=b[piv];b[piv]=t;
+        for(int r=c+1;r<M;r++){double f=a[r][c]/a[c][c];for(int j=c;j<M;j++)a[r][j]-=f*a[c][j];b[r]-=f*b[c];}
+    }
+    for(int r=M-1;r>=0;r--){double v=b[r];for(int j=r+1;j<M;j++)v-=a[r][j]*b[j];b[r]=v/a[r][r];}
+}
+static void open_coefficients(void) {
+    double sum=0,i0b=bessel_i0(OPEN_PROTO_BETA),proto[LEN];
+    for(int n=0;n<LEN;n++){
+        double x=n-(LEN-1)/2.0,r=2.0*n/(LEN-1)-1.0;
+        proto[n]=sinc_pi(x*OPEN_PROTO_CUTOFF/N)*bessel_i0(OPEN_PROTO_BETA*sqrt(fmax(0.0,1-r*r)))/i0b;
+        sum+=proto[n];
+    }
+    for(int n=0;n<LEN;n++)prototype[n]=(float)(proto[n]*OPEN_PROTO_DC/sum);
+    for(int p=0;p<HOP;p++)normalizer[p]=2*HOP;
+    memset(coefficients,0,sizeof(coefficients));
+    for(int b=0;b<B;b++){
+        double th=(150.0-45.0*b)*PI/180.0,ux=cos(th),uy=sin(th);
+        for(int k=0;k<N/2;k++){
+            double f=(k>0?k:0.5)*RATE_HZ/N,g[M][M],dre[M],dim[M],xr[M],xi[M];
+            for(int i=0;i<M;i++){
+                for(int j=0;j<M;j++){
+                    double dx=(open_mic_mm[i][0]-open_mic_mm[j][0])/1000,dy=(open_mic_mm[i][1]-open_mic_mm[j][1])/1000;
+                    g[i][j]=sinc_pi(2*f*sqrt(dx*dx+dy*dy)/OPEN_SOUND)+(i==j?OPEN_LOADING:0);
+                }
+                double tau=-(open_mic_mm[i][0]/1000*ux+open_mic_mm[i][1]/1000*uy)/OPEN_SOUND;
+                dre[i]=cos(-2*PI*f*tau);dim[i]=sin(-2*PI*f*tau);
+                xr[i]=dre[i];xi[i]=dim[i];
+            }
+            double g2[M][M];memcpy(g2,g,sizeof(g2));
+            solve4(g,xr);solve4(g2,xi);          /* the coherence matrix is real */
+            /* d^H w for w = xr + j xi */
+            double nre=0,nim=0;
+            for(int i=0;i<M;i++){nre+=dre[i]*xr[i]+dim[i]*xi[i];nim+=dre[i]*xi[i]-dim[i]*xr[i];}
+            double den=nre*nre+nim*nim;
+            for(int i=0;i<M;i++){
+                /* w = (xr + j xi) / (nre + j nim); the frontend applies conj(w). */
+                double wr=(xr[i]*nre+xi[i]*nim)/den,wi=(xi[i]*nre-xr[i]*nim)/den;
+                coefficients[b][k][0][i]=(cpx){(float)wr,(float)-wi};
+            }
+        }
+    }
+}
