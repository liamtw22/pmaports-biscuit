diff --git a/main/boot-deploy/fix-append-dtb-mtk-header.patch b/main/boot-deploy/fix-append-dtb-mtk-header.patch
new file mode 100644
index 000000000..0e9bf91e5
--- /dev/null
+++ b/main/boot-deploy/fix-append-dtb-mtk-header.patch
@@ -0,0 +1,20 @@
+Fix add_mtk_header() to wrap the DTB-appended kernel file (vmlinuz-dtb)
+instead of the plain kernel when deviceinfo_append_dtb=true, so the
+resulting vmlinuz-dtb-mtk matches what create_bootimg() already looks
+for. Without this, the MTK-wrapped file never includes the appended
+DTB, and create_bootimg() silently falls back to an unwrapped
+vmlinuz-dtb that MediaTek's legacy LK can't parse.
+
+--- a/boot-deploy-functions.sh
++++ b/boot-deploy-functions.sh
+@@ -467,6 +467,9 @@ add_mtk_header() {
+	if [ -n "${_kernel_label}" ]; then
+		log_arrow "kernel: adding MediaTek header"
+		# shellcheck disable=SC3060
+		local _kernel="$work_dir/$kernel_filename"
++		if [ "${deviceinfo_append_dtb}" = "true" ] && [ -f "${_kernel}-dtb" ]; then
++			_kernel="${_kernel}-dtb"
++		fi
+		rm -f "${_kernel}-mtk"
+		mtk-mkimage "${_kernel_label}" "$_kernel" "${_kernel}-mtk"
+		additional_files="$additional_files $(basename "${_kernel}"-mtk)"
