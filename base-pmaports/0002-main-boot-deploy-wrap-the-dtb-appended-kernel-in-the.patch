From dcd0c910b3cad47e9bd2139d67acf7ab715d7e6e Mon Sep 17 00:00:00 2001
From: jonasradke <me@jonasradke.com>
Date: Thu, 15 Oct 2026 11:15:08 +0200
Subject: [PATCH 2/3] main/boot-deploy: wrap the dtb-appended kernel in the
 MediaTek header

add_mtk_header() wraps the bare kernel (vmlinuz-mtk), while create_bootimg()
looks for the wrapper on the dtb-appended kernel (vmlinuz-dtb-mtk) whenever
deviceinfo_append_dtb=true. The two never meet, so the boot image ships a
kernel with no MediaTek header. MediaTek's LK then treats it as a 32-bit
kernel and takes a data abort about eleven seconds into every boot.

Wrap the dtb-appended file when append_dtb is set. Also moves the package
to 0.25.0 and bumps pkgrel to 1 so that it outranks upstream's 0.25.0-r0;
an older local version would be silently replaced by the binary repo's
unpatched build. Upstream 0.25.0 still has the bug.

Needed by amazon-biscuit (MT8163): check that the first four bytes of the
boot.img kernel are 88 16 88 58.
---
 main/boot-deploy/APKBUILD                     | 10 +++++++---
 .../fix-append-dtb-mtk-header.patch           | 19 +++++++++++++++++++
 2 files changed, 26 insertions(+), 3 deletions(-)
 create mode 100644 main/boot-deploy/fix-append-dtb-mtk-header.patch

diff --git a/main/boot-deploy/APKBUILD b/main/boot-deploy/APKBUILD
index 128d4c5..37ddeb1 100644
--- a/main/boot-deploy/APKBUILD
+++ b/main/boot-deploy/APKBUILD
@@ -1,17 +1,20 @@
 maintainer="Clayton Craft <clayton@craftyguy.net>"
 pkgname=boot-deploy
-pkgver=0.23.0
-pkgrel=0
+pkgver=0.25.0
+pkgrel=1
 pkgdesc="tool for finalizing and deploying boot related files"
 url="https://gitlab.postmarketos.org/postmarketOS/boot-deploy"
 arch="noarch"
 license="GPL-2.0-or-later"
 source="
 	https://gitlab.postmarketos.org/postmarketOS/boot-deploy/-/archive/$pkgver/boot-deploy-$pkgver.tar.gz
+	fix-append-dtb-mtk-header.patch
 
 	os-customization
 	"
 depends="generate-kernel-cmdline"
+# needed for /usr/lib/os-release
+checkdepends="postmarketos-release"
 
 check() {
 	./test_boot_deploy_functions.sh
@@ -29,6 +32,7 @@ package() {
 		"$pkgdir"/usr/share/mkinitfs-triggers/boot-deploy
 }
 sha512sums="
-f5b2bb096207944b5821065506ed1123be2b70dfabe91572cfa44e986f9f71d712ae0863bd845d9c120623bc0ce5963fb3f278d072b5525b12399592f129277c  boot-deploy-0.23.0.tar.gz
+a1fa5bb4380cbdf593db78353a533a3b8115d382a0f3ad9ee212b03fba13ea7276fcd026b266ac3194fe578f7338f65a5759fe257c008e0fe8b7bef031004e0b  boot-deploy-0.25.0.tar.gz
+00652360c4eeb9f2ff2e0d4ae52953dc69d3bc000a35d34545cea5d479546129f74a1a403682f2ce91bbeb9c75764daaac74b9b5700efd794e44a1d2a5f599cd  fix-append-dtb-mtk-header.patch
 a243975b9850d9933e0f917f7eb38fc4a76ea658c3dcc56f035f60ee6c62d6740c1107143b8210bdc0231d4c9b6b2003e458120985604eb09649322d359ae89f  os-customization
 "
diff --git a/main/boot-deploy/fix-append-dtb-mtk-header.patch b/main/boot-deploy/fix-append-dtb-mtk-header.patch
new file mode 100644
index 0000000..bc9597a
--- /dev/null
+++ b/main/boot-deploy/fix-append-dtb-mtk-header.patch
@@ -0,0 +1,19 @@
+Fix add_mtk_header() to wrap the DTB-appended kernel file (vmlinuz-dtb)
+instead of the plain kernel when deviceinfo_append_dtb=true, so the
+resulting vmlinuz-dtb-mtk matches what create_bootimg() already looks
+for. Without this, the MTK-wrapped file never includes the appended
+DTB, and create_bootimg() silently falls back to an unwrapped
+vmlinuz-dtb that MediaTek's legacy LK can't parse.
+
+--- a/boot-deploy-functions.sh
++++ b/boot-deploy-functions.sh
+@@ -478,6 +478,9 @@
+ 		log_arrow "kernel: adding MediaTek header"
+ 		# shellcheck disable=SC3060
+ 		local _kernel="$work_dir/$kernel_filename"
++		if [ "${deviceinfo_append_dtb}" = "true" ] && [ -f "${_kernel}-dtb" ]; then
++			_kernel="${_kernel}-dtb"
++		fi
+ 		rm -f "${_kernel}-mtk"
+ 		mtk-mkimage "${_kernel_label}" "$_kernel" "${_kernel}-mtk"
+ 		additional_files="$additional_files $(basename "${_kernel}"-mtk)"
