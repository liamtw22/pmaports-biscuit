-+	err = sys_mount("devtmpfs", (char *)mntdir, "devtmpfs", MS_SILENT, NULL);
-+	if (err)
-+		printk(KERN_INFO "devtmpfs: error mounting %i\n", err);
-+	else
-+		printk(KERN_INFO "devtmpfs: mounted\n");
-+	return err;
