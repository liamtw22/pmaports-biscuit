-+	kgid_t gid;
-+
-+	if (!value)
-+		return;
-+	if (size < sizeof(posix_acl_xattr_header))
-+		return;
-+	if (header->a_version != cpu_to_le32(POSIX_ACL_XATTR_VERSION))
-+		return;
-+
-+	count = posix_acl_xattr_count(size);
